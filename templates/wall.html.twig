<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Poster Wall · {{ site_title }}</title>
    <link rel="stylesheet" href="{{ asset('/assets/wall.css') }}">
</head>
<body>
    <div class="wall">
        <div class="wall__layer" data-layer="0">
            <div class="wall__bg"></div>
            <img class="wall__poster" alt="">
            <div class="wall__banner wall__banner--top">Currently Streaming</div>
            <div class="wall__banner wall__banner--bottom">
                <span class="wall__title"></span>
                <span class="wall__meta">
                    <span class="wall__detail"></span>
                    <span class="wall__user"></span>
                </span>
            </div>
        </div>
        <div class="wall__layer" data-layer="1">
            <div class="wall__bg"></div>
            <img class="wall__poster" alt="">
            <div class="wall__banner wall__banner--top">Currently Streaming</div>
            <div class="wall__banner wall__banner--bottom">
                <span class="wall__title"></span>
                <span class="wall__meta">
                    <span class="wall__detail"></span>
                    <span class="wall__user"></span>
                </span>
            </div>
        </div>
        <p class="wall__empty" hidden>No posters to show yet. Import some from Plex first.</p>
    </div>
    <script src="{{ asset('/assets/wall.js') }}"></script>
</body>
</html>
