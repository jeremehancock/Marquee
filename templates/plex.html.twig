{% extends 'layout.html.twig' %}

{# Suppresses the header's own Import link, which would point at this page. #}
{% set nav_current = 'import' %}

{% block title %}Import from Plex · {{ site_title }}{% endblock %}

{% block content %}
    <p><a class="search__clear" href="{{ back_url }}">&larr; Back to gallery</a></p>
    <h1>Import from Plex</h1>

    {% if flash %}
        <p class="alert alert--{{ flash.type }}" role="alert">{{ flash.message }}</p>
    {% endif %}

    {% if error %}
        <p class="alert" role="alert">{{ error }}</p>
    {% elseif libraries is empty %}
        <div class="panel">
            {% if has_exclusions %}
                {# Names the screen, not the old environment variable: the
                   exclusions are chosen in Marquee now, and sending someone to
                   edit a compose file would send them somewhere that no longer
                   configures anything. #}
                <p>No libraries are available to import — every one of them is
                   excluded. Change that in <a href="/settings">Settings</a>.</p>
            {% else %}
                <p>No movie or TV libraries were found on your Plex server.</p>
            {% endif %}
        </div>
    {% else %}
        {% set movie_count = libraries|filter(l => l.isMovie)|length %}
        {% set tv_count = libraries|filter(l => not l.isMovie)|length %}
        <form class="panel form" method="post" action="/plex/import"
              x-data="{
                  type: '',
                  sections: [],
                  importing: false,
                  movieLibs: {{ movie_count }},
                  tvLibs: {{ tv_count }},
                  get available() {
                      if (this.type === 'movie') return this.movieLibs;
                      if (this.type === 'collection') return this.movieLibs + this.tvLibs;
                      if (this.type === 'show' || this.type === 'season') return this.tvLibs;
                      return 0;
                  },
                  get ready() {
                      return this.type !== '' && this.sections.length > 0;
                  }
              }" @submit="if (!ready || importing) { $event.preventDefault(); return; } importing = true">
            {{ csrf_field() }}

            <fieldset class="fieldset">
                <legend>Step 1 — What do you want to import?</legend>
                <div class="choice-row">
                    {% for type in mediaTypes %}
                        <label class="choice">
                            <input type="radio" name="types[]" value="{{ type.value }}"
                                   x-model="type" @change="sections = []">
                            <span>{{ type.label }}</span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            <fieldset class="fieldset" x-show="type" x-cloak>
                <legend>Step 2 — Which libraries?</legend>
                <p class="check__hint" x-show="available === 0">
                    None of your Plex libraries can provide this content type.
                </p>
                {% for library in libraries %}
                    {% set compat = library.isMovie
                        ? "type === 'movie' || type === 'collection'"
                        : "type === 'show' || type === 'season' || type === 'collection'" %}
                    <label class="check" x-show="{{ compat|raw }}" x-cloak>
                        <input type="checkbox" name="sections[]" value="{{ library.key }}" x-model="sections">
                        {{ library.title }}
                        <span class="check__meta">({{ library.isMovie ? 'Movies' : 'TV' }})</span>
                    </label>
                {% endfor %}
            </fieldset>

            {# Shown on `ready` — the same getter the Import button binds — and not on
               `type` alone, which offered it a step early: with a content type picked
               and no library ticked, the option was settable while the import it
               modifies could not run.

               The two conditions must stay identical rather than merely compatible.
               This checkbox is the one control the form's component does not own — no
               x-model reaches it — so x-show hides it without clearing it, and a
               hidden-but-checked box still submits force=1. Tying it to the button's
               own condition is what guarantees that anything able to change what an
               import does is on screen while it can. #}
            <label class="check" x-show="ready" x-cloak>
                <input type="checkbox" name="force" value="1">
                Re-download unchanged posters
            </label>

            {# The condition was always right; until now nothing drew it. aria-disabled
               keeps the button reachable so a keyboard user is told it is unavailable
               instead of never meeting it — and because that also keeps it pressable,
               the form's @submit and runImport() both refuse the same condition. #}
            <button type="submit" class="btn btn--accent"
                    :aria-disabled="!ready || importing ? 'true' : 'false'">Import</button>

            <div class="overlay" x-show="importing" x-cloak style="display:none">
                <div class="overlay__box">
                    <div class="spinner"></div>
                    <p><strong>Importing from Plex&hellip;</strong></p>
                    <p class="stats">This can take a while for large libraries. Please keep this page open.</p>
                </div>
            </div>
        </form>
        <p class="stats">Plex is the source of truth &mdash; importing overwrites any posters you&rsquo;ve changed there.</p>
    {% endif %}
{% endblock %}
