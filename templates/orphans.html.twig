{% extends 'layout.html.twig' %}
{% import 'partials/_transitions.html.twig' as tx %}

{# Suppresses the header's own Orphans link, which would point at this page. #}
{% set nav_current = 'orphans' %}

{% block title %}Orphaned posters · {{ site_title }}{% endblock %}

{% block content %}
<div x-data="orphansPage({{ configured ? 'true' : 'false' }})">
    <p><a class="search__clear" href="{{ back_url }}">&larr; Back to gallery</a></p>
    <h1>Orphaned posters</h1>
    <p class="stats">Orphans are posters imported from Plex whose media no longer exists there,
       or whose library is now excluded.</p>

    {% if flash %}
        <p class="alert alert--{{ flash.type }}" role="alert">{{ flash.message }}</p>
    {% endif %}

    {% if not configured %}
        <div class="panel">
            <p>Marquee must be connected to Plex to detect orphans.
               <a href="/plex">Connect it on the Import page.</a></p>
        </div>
    {% else %}
        {# Filled by GET /orphans/list once the scan resolves. #}
        <div id="orphan-results" x-ref="results">
            <noscript>
                <div class="panel"><p>Orphan detection requires JavaScript. Please enable it and reload the page.</p></div>
            </noscript>
        </div>

        {# Loading overlay — visible until the scan resolves. #}
        <div class="overlay" x-show="loading" x-cloak style="display:none">
            <div class="overlay__box">
                <div class="spinner"></div>
                <p><strong>Checking Plex for orphans&hellip;</strong></p>
                <p class="stats">This can take a while for large libraries. Please keep this page open.</p>
            </div>
        </div>

        {# Delete progress overlay — the delete is verified against Plex, which
           can take a few seconds on a large library. Shown for both a single
           delete and delete-all. #}
        <div class="overlay" x-show="deleting" x-cloak style="display:none">
            <div class="overlay__box">
                <div class="spinner"></div>
                <p><strong>Deleting&hellip;</strong></p>
                <p class="stats">Removing orphaned posters from Plex. Please keep this page open.</p>
            </div>
        </div>

        {# Delete-all confirmation — count is filled in after the scan. #}
        <div class="modal" x-show="confirmOpen" x-cloak {{ tx.dialog() }}
             @keydown.escape.window="confirmOpen = false" style="display:none">
            <div class="modal__backdrop" @click="confirmOpen = false"></div>
            <div class="modal__panel modal__panel--narrow" role="dialog" aria-modal="true" aria-label="Confirm delete">
                {# Grab handle: hidden on desktop, the drag-to-dismiss target on a
                   phone. See _overlays.html.twig for why it is a real element. #}
                <div class="sheet__grip"><span class="sheet__handle"></span></div>
                <div class="modal__head">
                    <h2>Delete all orphans?</h2>
                    <button type="button" class="modal__close" @click="confirmOpen = false" aria-label="Close">&times;</button>
                </div>
                <div class="modal__body">
                    <p class="stats">This permanently removes <span x-text="count"></span> orphaned poster<span x-show="count !== 1">s</span>. This cannot be undone.</p>
                    <div class="modal__actions">
                        <button type="button" class="btn" @click="confirmOpen = false">Cancel</button>
                        <button type="button" class="btn btn--danger" @click="deleteAllNow()">Delete all</button>
                    </div>
                </div>
            </div>
        </div>

        {# Shared per-orphan confirm dialog, mobile action tray, viewer, toast. #}
        {% include 'partials/_overlays.html.twig' %}
    {% endif %}
</div>
{% endblock %}
