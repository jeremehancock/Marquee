{# Orphan scan result, rendered both on a full render and by GET /orphans/list.
   Plain HTML with data-* hooks — the delete-all overlay lives in the shell. #}
{% if error %}
    <p class="alert" role="alert">{{ error }}</p>
{% elseif orphans is empty %}
    <div class="panel">
        <p>No orphaned posters found.</p>
        <button type="button" class="btn" data-action="recheck">Re-check for orphans</button>
    </div>
{% else %}
    <div class="toolbar" data-count="{{ orphans|length }}">
        <p class="stats">{{ orphans|length }} orphaned poster{{ orphans|length == 1 ? '' : 's' }}.</p>
        <button type="button" class="btn btn--danger" data-action="delete-all">Delete all orphans</button>
    </div>

    <div class="grid">
        {% for orphan in orphans %}
            {% set orphan_url = '/posters/' ~ orphan.category ~ '/' ~ orphan.filename|url_encode %}
            <figure class="card" data-category="{{ orphan.category }}" data-filename="{{ orphan.filename }}">
                <div class="card__frame">
                    <img class="card__image" src="{{ orphan_url }}"
                         alt="{{ orphan.title }}" loading="lazy">
                    <div class="card__overlay">
                        <div class="card__actions">
                            <a class="btn btn--small" href="{{ orphan_url }}" download>Download</a>
                            <form class="js-mutate" method="post" action="/orphans/delete"
                                  data-confirm="Permanently delete the orphaned poster “{{ orphan.title }}”? This cannot be undone.">
                                {{ csrf_field() }}
                                <input type="hidden" name="category" value="{{ orphan.category }}">
                                <input type="hidden" name="filename" value="{{ orphan.filename }}">
                                <button type="submit" class="btn btn--small btn--danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
                {# data-tooltip-truncated: the tooltip only restates this caption,
                   so it is shown only while the title is too long to fit. #}
                <figcaption class="card__caption" data-tooltip="{{ orphan.title }}" data-tooltip-truncated>{{ orphan.title }}</figcaption>
            </figure>
        {% endfor %}
    </div>
{% endif %}
