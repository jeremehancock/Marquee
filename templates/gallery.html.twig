{% extends 'layout.html.twig' %}
{% import 'partials/_nav_macros.html.twig' as nav %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}{{ view.label }} · {{ site_title }}{% endblock %}

{% set base = '/library/' ~ view.value %}

{% block content %}
<div data-gallery data-base="{{ base }}" x-data="galleryUI"
     @gallery:view.window="view($event.detail.url)"
     @gallery:copy.window="copyUrl($event.detail.url)"
     @gallery:change.window="openChange($event.detail.filename, $event.detail.title, $event.detail.category)"
     @gallery:confirm.window="askConfirm($event.detail)"
     @gallery:toast.window="notify($event.detail.text)"
     @gallery:sheet.window="openSheet($event.detail)"
     @gallery:sheet-close.window="closeSheet()"
     @gallery:import.window="openImport()"
     @gallery:orphans.window="openOrphans()"
     @gallery:done.window="change.open = false">

    {% if flash %}
        <p class="alert alert--{{ flash.type }}" role="alert">{{ flash.message }}</p>
    {% endif %}

    {# Carry the active search (and a non-default sort) into every tab so
       switching views keeps the current filter even without JavaScript. #}
    {% set tab_query = query is not empty ? 'q=' ~ query|url_encode : '' %}
    {% set tab_query = tab_query ~ (sort == 'date_added' ? (tab_query is not empty ? '&' : '') ~ 'sort=date_added' : '') %}
    {# Short labels drop the "TV " prefix so all five tabs fit the phone tab bar
       under their icons; the full label stays as the link's accessible name. #}
    {% set tab_short = { 'all': 'All', 'movies': 'Movies', 'tv-shows': 'Shows', 'tv-seasons': 'Seasons', 'collections': 'Collections' } %}
    <nav class="tabs">
        {% for tab in tabs %}
            <a class="tab {{ tab.active ? 'tab--active' : '' }}"
               href="/library/{{ tab.value }}{{ tab_query is not empty ? '?' ~ tab_query : '' }}"
               aria-label="{{ tab.label }}" {{ tab.active ? 'aria-current="page"' : '' }}>
                <span class="tab__icon" aria-hidden="true">{{ icons.icon(tab.value) }}</span>
                <span class="tab__text" aria-hidden="true">{{ tab.label }}</span>
                <span class="tab__text tab__text--short" aria-hidden="true">{{ tab_short[tab.value] ?? tab.label }}</span>
            </a>
        {% endfor %}
    </nav>

    <div class="toolbar">
        {# The only clear control lives with the filtered-state summary in
           #results — the toolbar is never swapped by a no-reload update, so a
           clear link here would go stale the moment the results change. #}
        <form class="search" method="get" action="{{ base }}" role="search">
            <input type="search" name="q" value="{{ query }}" autocomplete="off"
                   placeholder="Search {{ view.label }}…" aria-label="Search">
        </form>
        {% set sort_q = query is not empty ? '&q=' ~ query|url_encode : '' %}
        {# Phone-only affordance: opens the sort tray. The inline .sort group below
           stays for desktop. #}
        <button type="button" class="icon-btn sort-trigger" @click="sortOpen = true"
                aria-label="Sort order" data-tooltip="Sort">
            {{ icons.icon('sort') }}
        </button>
        <div class="sort" role="group" aria-label="Sort order">
            <span class="sort__label">Sort</span>
            <a class="btn btn--small {{ sort == 'alphabetical' ? 'btn--accent' : '' }}"
               href="{{ base }}?sort=alphabetical{{ sort_q }}" data-sort="alphabetical"
               {{ sort == 'alphabetical' ? 'aria-current="true"' : '' }}>A–Z</a>
            <a class="btn btn--small {{ sort == 'date_added' ? 'btn--accent' : '' }}"
               href="{{ base }}?sort=date_added{{ sort_q }}" data-sort="date_added"
               {{ sort == 'date_added' ? 'aria-current="true"' : '' }}>Date added</a>
        </div>
        <div class="toolbar__actions">
            {{ nav.secondary_links() }}
        </div>
    </div>

    <div id="results">
        {% include 'partials/gallery_results.html.twig' %}
    </div>

    {# Change poster modal #}
    {# Escape unwinds one layer at a time. Both this dialog and the confirm dialog
       stacked over it listen on the window, so an unguarded handler would close
       both — declining a confirmation would also discard the file the user had
       just picked. Ordering cannot fix that; only the guard can. #}
    <div class="modal" x-show="change.open" x-cloak
         @keydown.escape.window="if (!confirm.open) change.open = false" style="display:none">
        <div class="modal__backdrop" @click="change.open = false"></div>
        <div class="modal__panel" :class="change.tab === 'find' ? 'modal__panel--wide' : ''"
             role="dialog" aria-modal="true" aria-label="Change poster">
            {# Grab handle: hidden on desktop, the drag-to-dismiss target on a
               phone. A real element rather than a pseudo-element so touch can
               actually target it — see _overlays.html.twig. #}
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="modal__head">
                <h2>Change poster</h2>
                <button type="button" class="modal__close" @click="change.open = false" aria-label="Close">&times;</button>
            </div>
            <div class="modal__body">
                <p class="stats" x-text="change.title"></p>
                <div class="modal__tabs">
                    <button type="button" :class="change.tab === 'upload' ? 'is-active' : ''" @click="change.tab = 'upload'">Upload</button>
                    <button type="button" :class="change.tab === 'url' ? 'is-active' : ''" @click="change.tab = 'url'">From URL</button>
                    <button type="button" :class="change.tab === 'find' ? 'is-active' : ''"
                            @click="change.tab = 'find'; if (!finder.results.length && !finder.loading) findPosters()">Find Posters</button>
                </div>

                {# data-refresh="card": both tabs replace one poster's image and nothing
                   else, so the grid is left standing and only that card is rebuilt. See
                   the note in partials/gallery_results.html.twig. #}
                {# Both tabs confirm before they post, the same way the card's Send,
                   Fetch and Delete forms do — the delegated submit handler parks the
                   form and opens the shared dialog, so the file or URL is still there
                   if the answer is no. The message is bound rather than written into
                   the markup because this dialog is one instance reused for whichever
                   poster was tapped; only Alpine knows which that is. #}
                <form class="form js-mutate" method="post" :action="'/library/' + change.category + '/change/upload'"
                      enctype="multipart/form-data" x-show="change.tab === 'upload'"
                      data-refresh="card" :data-category="change.category"
                      :data-confirm="'Replace the poster for “' + change.title + '” with the selected image?'"
                      data-confirm-title="Change poster?"
                      data-confirm-label="Change poster"
                      data-confirm-tone="accent">
                    <input type="hidden" name="filename" :value="change.filename">
                    <label for="change-file">Image file (JPG, PNG, or WebP)</label>
                    <input id="change-file" x-ref="changeFile" type="file" name="poster" accept="image/jpeg,image/png,image/webp" required>
                    <button type="submit" class="btn btn--accent">Change poster</button>
                </form>

                <form class="form js-mutate" method="post" :action="'/library/' + change.category + '/change/url'"
                      x-show="change.tab === 'url'" data-refresh="card" :data-category="change.category"
                      :data-confirm="'Replace the poster for “' + change.title + '” with the image at that URL?'"
                      data-confirm-title="Change poster?"
                      data-confirm-label="Change poster"
                      data-confirm-tone="accent">
                    <input type="hidden" name="filename" :value="change.filename">
                    <label for="change-url">Image URL</label>
                    <input id="change-url" x-ref="changeUrl" type="url" name="url" placeholder="https://…" required>
                    <button type="submit" class="btn btn--accent">Change poster</button>
                </form>

                <div x-show="change.tab === 'find'">
                    <p class="stats" x-show="finder.loading">Finding posters…</p>
                    <p class="alert" x-show="finder.error && !finder.loading" x-text="finder.error"></p>
                    <p class="alert" x-show="finder.notice && !finder.loading" x-text="finder.notice"></p>
                    <p class="stats" x-show="!finder.loading && !finder.error && finder.results.length">
                        Tap a poster to preview it.
                    </p>
                    {# The grid loads each candidate's thumbnail where its source gave
                       one (thumb falls back to url server-side); previewing and
                       applying always use the full-resolution url. #}
                    <div class="find-grid">
                        <template x-for="poster in finder.results" :key="poster.url">
                            {# Each cell tracks its own image, so the shimmer stops per
                               candidate as each thumbnail arrives. The DOM scan that
                               does this for poster cards (initImages in gallery.js)
                               cannot: Alpine creates and destroys these images on every
                               search, long after that scan has run. `@error` resolves
                               the cell too — a candidate whose image 404s must stop
                               shimmering rather than promise one that is never coming. #}
                            <figure class="find-item" x-data="{ loaded: false }">
                                <div class="find-item__frame">
                                    <img class="find-item__img" :src="poster.thumb" alt="" loading="lazy"
                                         :class="loaded ? 'is-loaded' : ''"
                                         @load="loaded = true" @error="loaded = true"
                                         @click="openFinderPreview(poster.url)" data-tooltip="Click to preview">
                                </div>
                            </figure>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Find Posters preview: a candidate shown full screen with a use/close choice
       and an inline confirm step, on both desktop and touch. #}
    <div class="viewer viewer--finder" x-show="finder.preview" x-cloak
         @click.self="closeFinderPreview()"
         @keydown.escape.window="closeFinderPreview()" style="display:none">
        {# The stage now covers the space beside the image, so it has to close the
           preview on its own account: without this, the only backdrop left that
           reaches the viewer's own handler is the strip around the action bar. #}
        <div class="viewer__stage" @click.self="closeFinderPreview()">
            <div class="viewer__placeholder" x-show="!finder.previewLoaded"></div>
            <img :src="finder.preview" alt="" :class="finder.previewLoaded ? 'is-loaded' : ''"
                 @load="finder.previewLoaded = true" @error="finder.previewLoaded = true">
        </div>
        <div class="viewer__bar">
            <div class="viewer__actions" x-show="!finder.confirming">
                <button type="button" class="btn btn--accent" @click="finder.confirming = true">Use this poster</button>
                <button type="button" class="btn" @click="closeFinderPreview()">Close</button>
            </div>
            <div class="viewer__actions" x-show="finder.confirming" x-cloak>
                <span class="viewer__ask">Change the poster to this one?</span>
                <button type="button" class="btn btn--accent" @click="applyFinderSelection()"
                        :disabled="finder.applying">Change poster</button>
                <button type="button" class="btn" @click="finder.confirming = false"
                        :disabled="finder.applying">Cancel</button>
            </div>
        </div>
        {# Progress while the change runs. Shown immediately rather than after a
           grace period — the server has to fetch the full-resolution image and
           push it to Plex, so this is never fast (see applyFinderSelection).
           Full screen, not scoped to the change-poster panel: the preview above
           covers that panel, so an overlay confined to it would sit underneath
           the thing the user is looking at. `.overlay` is z-index 100 against
           the viewer's 60, so it lands on top with no new CSS. #}
        <div class="overlay" x-show="finder.applying" x-cloak style="display:none">
            <div class="overlay__box">
                <div class="spinner"></div>
                <p><strong>Changing poster&hellip;</strong></p>
                <p class="stats">Fetching the poster and sending it to Plex. Please keep this page open.</p>
            </div>
        </div>
    </div>

    {# Sort tray (phone): the same sort links as the desktop toolbar, presented as
       an app-style sheet to keep the toolbar uncluttered. #}
    <div class="sheet" x-show="sortOpen" x-cloak @keydown.escape.window="sortOpen = false" style="display:none">
        <div class="sheet__backdrop" @click="sortOpen = false"></div>
        <div class="sheet__panel" role="dialog" aria-modal="true" aria-label="Sort order">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Sort</span></div>
            <div class="sheet__body menu__body">
                <a class="btn {{ sort == 'alphabetical' ? 'btn--accent' : '' }}"
                   href="{{ base }}?sort=alphabetical{{ sort_q }}" data-sort="alphabetical"
                   {{ sort == 'alphabetical' ? 'aria-current="true"' : '' }}>A–Z</a>
                <a class="btn {{ sort == 'date_added' ? 'btn--accent' : '' }}"
                   href="{{ base }}?sort=date_added{{ sort_q }}" data-sort="date_added"
                   {{ sort == 'date_added' ? 'aria-current="true"' : '' }}>Date added</a>
            </div>
        </div>
    </div>

    {# Import tray (phone): the Import from Plex link opens this instead of
       navigating; its body is fetched from /plex and wired on first open. #}
    <div class="sheet" x-show="importOpen" x-cloak @keydown.escape.window="closeImport()" style="display:none">
        <div class="sheet__backdrop" @click="closeImport()"></div>
        <div class="sheet__panel sheet__panel--tall" role="dialog" aria-modal="true" aria-label="Import from Plex">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Import from Plex</span></div>
            <div class="sheet__body">
                <p class="stats" x-show="importLoading">Loading…</p>
                <div x-ref="importBody" data-nested-scope></div>
            </div>
        </div>
    </div>

    {# Orphans tray (phone): the Orphans link opens this instead of navigating. Its
       body is the /orphans page content, fetched and wired on first open so its
       own scan/delete logic and (now tray-contained) progress overlays are reused. #}
    <div class="sheet" x-show="orphansOpen" x-cloak @keydown.escape.window="closeOrphans()" style="display:none">
        <div class="sheet__backdrop" @click="closeOrphans()"></div>
        <div class="sheet__panel sheet__panel--tall" role="dialog" aria-modal="true" aria-label="Orphaned posters">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Orphaned posters</span></div>
            <div class="sheet__body" x-ref="orphansBody" data-nested-scope>
                <p class="stats" x-show="orphansLoading">Loading…</p>
            </div>
        </div>
    </div>

    {# Shared confirm dialog, mobile action tray, fullscreen viewer, and toast. #}
    {% include 'partials/_overlays.html.twig' %}
</div>
{% endblock %}
