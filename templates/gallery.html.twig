{% extends 'layout.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}
{% import 'partials/_sort.html.twig' as sort_control %}
{% import 'partials/_transitions.html.twig' as tx %}

{% block title %}{{ view.label }} · {{ site_title }}{% endblock %}

{# One group of Plex poster candidates. `source` is an Alpine expression naming
   the array, so both groups render from one piece of markup. The whole group is
   dropped when it is empty rather than left as a heading over nothing — an item
   with no uploads must not show an "Uploaded to Plex" label with a gap under it.

   A tile is identical whether or not Plex already holds the image: `thumb` is
   already the right address for either, and openPlexPreview() reads the
   candidate's own `held` flag to decide how applying it will reach Plex. That
   difference is real but it is not something a user is choosing between, so it
   does not show up here. #}
{% macro plex_group(label, source) %}
    <template x-if="{{ source }}.length">
        <div class="poster-group">
            <p class="poster-group__heading">
                <span>{{ label }}</span>
                <span class="poster-group__count" x-text="{{ source }}.length"></span>
            </p>
            <div class="find-grid">
                <template x-for="poster in {{ source }}" :key="poster.ref">
                    {# Per-cell loaded flag, as in the Find Posters grid: Alpine builds
                       and tears these down long after initImages() has run, and `@error`
                       must resolve the cell too so a candidate whose image fails stops
                       shimmering instead of promising one that is never coming. #}
                    <figure class="find-item" x-data="{ loaded: false }">
                        <div class="find-item__frame">
                            <template x-if="poster.selected">
                                <span class="find-item__badge">In use</span>
                            </template>
                            <img class="find-item__img" :src="poster.thumb" alt="" loading="lazy"
                                 :class="loaded ? 'is-loaded' : ''"
                                 @load="loaded = true" @error="loaded = true"
                                 @click="openPlexPreview(poster)"
                                 :data-tooltip="poster.selected ? 'The poster Plex is using now — click to preview' : 'Click to preview'">
                        </div>
                    </figure>
                </template>
            </div>
        </div>
    </template>
{% endmacro %}

{% set base = '/library/' ~ view.value %}

{% block content %}
<div data-gallery data-base="{{ base }}" x-data="galleryUI"
     @gallery:view.window="view($event.detail.url)"
     @gallery:change.window="openChange($event.detail.filename, $event.detail.title, $event.detail.category, $event.detail.linked)"
     @gallery:confirm.window="askConfirm($event.detail)"
     @gallery:toast.window="notify($event.detail.text)"
     @gallery:sheet.window="openSheet($event.detail)"
     @gallery:sheet-close.window="closeSheet()"
     @gallery:import.window="openImport()"
     @gallery:orphans.window="openOrphans()"
     @gallery:settings.window="openSettings()"
     @gallery:connect.window="openConnect()"
     @gallery:done.window="change.open = false">

    {% if flash %}
        <p class="alert alert--{{ flash.type }}" role="alert">{{ flash.message }}</p>
    {% endif %}

    {# Carry the active search and the current sort into every tab so switching
       views keeps both even without JavaScript. The sort goes on unconditionally
       rather than only when it differs from the default: with a direction on each
       field there is no single slug that can be left off safely, and testing for
       one is how a reversed order silently resets itself on a tab switch. #}
    {# What a tab link carries with no scripting. A set and a query are
       alternatives the server never applies together, so exactly one goes here —
       the set winning, as it does on the server. Carrying the set is what makes
       Related posters behave the same whether it finds one or falls back to a
       title search; without it, a tab tap silently dropped the set while keeping
       a query. #}
    {% set tab_query = set_key is not empty
        ? 'set=' ~ set_key|url_encode ~ (set_from is not empty ? '&from=' ~ set_from|url_encode : '')
        : (query is not empty ? 'q=' ~ query|url_encode : '') %}
    {% set tab_query = tab_query ~ (tab_query is not empty ? '&' : '') ~ 'sort=' ~ sort %}
    {# Short labels drop the "TV " prefix so all five tabs fit the phone tab bar
       under their icons; the full label stays as the link's accessible name. #}
    {% set tab_short = { 'all': 'All', 'movies': 'Movies', 'tv-shows': 'Shows', 'tv-seasons': 'Seasons', 'collections': 'Collections' } %}
    {# Tabs and toolbar are pinned as one block on a pointer/desktop screen, so
       every category, search, and sort stay reachable at any scroll position.
       They are wrapped rather than pinned individually: two siblings both stuck
       to top: 0 would land on top of each other, and offsetting the second by the
       first's height would be a constant to keep in sync with the tabs' padding
       and font size. The wrapper has no such constant.

       On a phone the wrapper is `display: contents` (see app.css) — .toolbar does
       its own pinning there, and a sticky element cannot travel outside its
       containing block, so a wrapper this short would cut its range to nothing. #}
    <div class="gallery-head">
        <nav class="tabs">
            {% for tab in tabs %}
                <a class="tab {{ tab.active ? 'tab--active' : '' }}"
                   href="/library/{{ tab.value }}{{ tab_query is not empty ? '?' ~ tab_query : '' }}"
                   aria-label="{{ tab.label }}" {{ tab.active ? 'aria-current="page"' : '' }}>
                    <span class="tab__icon" aria-hidden="true">{{ icons.icon(tab.value) }}</span>
                    <span class="tab__text" aria-hidden="true">{{ tab.label }}</span>
                    <span class="tab__text tab__text--short" aria-hidden="true">{{ tab_short[tab.value] ?? tab.label }}</span>
                </a>
            {% endfor %}
        </nav>

        <div class="toolbar">
            {# The only clear control lives with the filtered-state summary in
               #results — the toolbar is never swapped by a no-reload update, so a
               clear link here would go stale the moment the results change. #}
            {# For the same reason the placeholder NAMES NO CATEGORY. It read
               "Search Movies…" and kept saying so on every other tab, because
               switching category rewrites #results and never this. It was true
               once, on the view the page happened to load with, and wrong from
               the first tab change onward — which the swipe made constant rather
               than introduced.

               Naming the view here cannot be fixed by choosing better wording;
               anything view-dependent in the toolbar is stale by construction. It
               is also not needed: the view is already named where it is
               re-rendered, in the filtered-state summary above the grid ("3
               matches for “dune” in Movies"), which is the requirement that asked
               for it. This now matches the accessible name, which has always been
               plain "Search".

               `action` and the sort links below are view-dependent too and stay
               that way: both are only followed with JavaScript off, where there
               is no no-reload switching to go stale against. The JS paths
               deliberately rebuild from window.location.pathname instead — see
               the sort branch in gallery.js. #}
            <form class="search" method="get" action="{{ base }}" role="search">
                <input type="search" name="q" value="{{ query }}" autocomplete="off"
                       placeholder="Search…" aria-label="Search">
            </form>
            {# Likewise for the sort links: one of the two, the set first. This
               is why changing sort no longer drops out of a set. #}
            {% set sort_q = set_key is not empty
                ? '&set=' ~ set_key|url_encode ~ (set_from is not empty ? '&from=' ~ set_from|url_encode : '')
                : (query is not empty ? '&q=' ~ query|url_encode : '') %}
            {# Phone-only affordance: opens the sort tray. The inline .sort group
               below stays for desktop. #}
            <button type="button" class="icon-btn sort-trigger" @click="sortOpen = true"
                    aria-label="Sort order" data-tooltip="Sort">
                {{ icons.icon('sort') }}
            </button>
            <div class="sort" role="group" aria-label="Sort order">
                <span class="sort__label">Sort</span>
                {{ sort_control.control(sort_state, base, sort_q, 'btn--small') }}
            </div>
        </div>
    </div>

    {# #results is the swap target for every no-reload update — search, paging,
       a mutation's re-render, and the category swipe's commit — all through
       setResults() in gallery.js. Its id and its position here are load-bearing;
       the swipe's incoming panel is a SIBLING inserted beside it for the length
       of a gesture and removed after, precisely so that none of those callers
       has to know the gesture exists. #}
    <div id="results">
        {% include 'partials/gallery_results.html.twig' %}
    </div>

    {# Cloned by the swipe when its neighbour cache misses. Inert until then. #}
    <template id="swipe-placeholder">{% include 'partials/_swipe_placeholder.html.twig' %}</template>

    {# Change poster modal #}
    {# Escape unwinds one layer at a time. This dialog, the confirm dialog and the
       full-screen preview all listen on the window, so an unguarded handler would
       close this one underneath whichever is stacked over it — discarding the file
       or URL the user had just picked along with it. Ordering cannot fix that;
       only the guard can. #}
    <div class="modal" x-show="change.open" x-cloak {{ tx.dialog() }}
         @keydown.escape.window="if (!confirm.open && !preview.open) change.open = false" style="display:none">
        <div class="modal__backdrop" @click="change.open = false"></div>
        {# The width is a property of the tab, not of the poster. On Plex Posters for
           a poster with no Plex item that means a wide dialog around one sentence,
           which looks like an oversight and is not: making it depend on the poster
           would trade a strip that keeps its shape for a panel that does not, and
           the dialog would resize as the user moved between an unlinked poster and a
           linked one. Same argument as the tab itself, one level up. #}
        {# `tabindex="-1"` on every dialog panel: the focus manager moves focus
           here on open, so the panel's own name is announced and the user tabs
           forward through its contents in order. Negative, so it takes focus
           programmatically without joining the tab order itself. #}
        <div class="modal__panel" :class="(change.tab === 'find' || change.tab === 'plex') ? 'modal__panel--wide' : ''"
             role="dialog" aria-modal="true" aria-label="Change poster" tabindex="-1">
            {# Grab handle: hidden on desktop, the drag-to-dismiss target on a
               phone. A real element rather than a pseudo-element so touch can
               actually target it — see _overlays.html.twig. #}
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="modal__head">
                <h2>Change poster</h2>
                <button type="button" class="modal__close" @click="change.open = false" aria-label="Close">&times;</button>
            </div>
            <div class="modal__body">
                <p class="stats" x-text="change.title"></p>
                <div class="modal__tabs">
                    <button type="button" :class="change.tab === 'upload' ? 'is-active' : ''" @click="change.tab = 'upload'">Upload</button>
                    <button type="button" :class="change.tab === 'url' ? 'is-active' : ''" @click="change.tab = 'url'">From URL</button>
                    {# Shown for every poster, and openable for every poster, so the strip
                       keeps its shape from poster to poster. Hiding it would leave a user
                       who learned where the tab sits finding it gone with no reason given.

                       A poster with no Plex item does not make this tab unavailable — it
                       makes it empty, in the same sense as a search that matched nothing.
                       That distinction is the whole reason the tab opens: an unavailable
                       control can only state its reason through the affordances of the
                       device in hand, and this app's hints are pointer-only by design (see
                       app.js), so the reason never reached a touch user at all. The panel
                       has no such gate. The reason lives there, in the words the server
                       uses for the same case, and reaches every device.

                       So the guard moved rather than went: it now sits on the request, not
                       on the tab switch, because what must not happen for an unlinked
                       poster is a call to Plex — not a change of tab. loadPlexPosters()
                       repeats the check at the point the request is made; see the note
                       there for why both. #}
                    <button type="button" :class="change.tab === 'plex' ? 'is-active' : ''"
                            @click="change.tab = 'plex'; if (change.linked && !plexPosters.uploaded.length && !plexPosters.available.length && !plexPosters.loading) loadPlexPosters()">Plex Posters</button>
                    <button type="button" :class="change.tab === 'find' ? 'is-active' : ''"
                            @click="change.tab = 'find'; if (!finder.sections.length && !finder.loading) findPosters()">Find Posters</button>
                </div>

                {# Neither tab changes anything on its own: it hands the image to the
                   full-screen preview below, which is where the commitment is made —
                   the same two steps a found candidate goes through. So these are not
                   js-mutate forms and raise no confirm dialog; applyPreview() posts
                   them. They stay <form>s so `required` and type="url" still gate the
                   action and Enter still submits the URL field. #}
                <form class="form" x-show="change.tab === 'upload'" @submit.prevent="openUploadPreview()">
                    <label for="change-file">Image file (JPG, PNG, or WebP)</label>
                    <input id="change-file" x-ref="changeFile" type="file" name="poster" accept="image/jpeg,image/png,image/webp" required>
                    <button type="submit" class="btn btn--accent">Upload poster</button>
                </form>

                <form class="form" x-show="change.tab === 'url'" @submit.prevent="openUrlPreview()">
                    <label for="change-url">Image URL</label>
                    <input id="change-url" x-ref="changeUrl" type="url" name="url" placeholder="https://…" required>
                    <button type="submit" class="btn btn--accent">Fetch poster</button>
                </form>

                {# What the Plex server already holds for this item. Two groups, uploads
                   first: Plex never prunes a poster, so an item edited over a year
                   accumulates a long tail, and the uploads are the user's own history —
                   the reason to come here at all. #}
                <div x-show="change.tab === 'plex'">
                    {# Why the tab has nothing, for a poster with no Plex item. Not an
                       outcome of a request — no request is made, because whether the
                       poster is linked is known from the card before the dialog opens.
                       It is drawn as the request's own empty outcomes are drawn, because
                       it is the same kind of answer: the tab has nothing, and here is why.

                       Worded exactly as ChangePosterController words PlexPosterOutcome
                       ::NotLinked, and that is not tidiness. change.linked comes from the
                       card and can go stale — an orphan cleanup or a re-import between
                       page render and dialog open — and when it does the request goes and
                       the server answers this same case. The two paths must say the same
                       sentence, or the user gets a different reason for the same fact.

                       Everything below is gated on change.linked so an unlinked poster
                       cannot also read as loading, as failed, or as having asked Plex and
                       come back empty-handed. #}
                    <p class="alert" x-show="!change.linked">This poster is not linked to a Plex item.</p>
                    <p class="stats" x-show="change.linked && plexPosters.loading">Reading posters from Plex…</p>
                    <p class="alert" x-show="change.linked && plexPosters.error && !plexPosters.loading" x-text="plexPosters.error"></p>
                    <p class="stats" x-show="change.linked && !plexPosters.loading && !plexPosters.error && (plexPosters.uploaded.length || plexPosters.available.length)">
                        Tap a poster to preview it.
                    </p>
                    <div class="poster-groups" x-show="change.linked && !plexPosters.loading && !plexPosters.error">
                        {{ _self.plex_group('Uploaded to Plex', 'plexPosters.uploaded') }}
                        {{ _self.plex_group('Offered by Plex', 'plexPosters.available') }}
                    </div>
                </div>

                <div x-show="change.tab === 'find'">
                    <p class="stats" x-show="finder.loading">Finding posters…</p>
                    <p class="alert" x-show="finder.error && !finder.loading" x-text="finder.error"></p>
                    <p class="alert" x-show="finder.notice && !finder.loading" x-text="finder.notice"></p>
                    <p class="stats" x-show="!finder.loading && !finder.error && finder.sections.length">
                        Tap a poster to preview it.
                    </p>
                    {# One section per service that supplied a candidate, in the order
                       the server sent them — which is fixed, so the tab has the same
                       shape for every poster. Nothing here names a provider: the label
                       and the order both arrive in the payload, so adding a service is
                       a server-side change only.

                       Shares .poster-group* with the Plex Posters tab above, which is
                       what carries the sticky headings and the gap-based spacing. The
                       spacing must stay a flex gap: `x-for` leaves the <template> in
                       the DOM between every pair of sections, so an adjacent-sibling
                       selector would match nothing at all (see app.css). #}
                    <div class="poster-groups">
                        <template x-for="section in finder.sections" :key="section.label">
                            <div class="poster-group">
                                <p class="poster-group__heading">
                                    <span x-text="section.label"></span>
                                    <span class="poster-group__count" x-text="section.posters.length"></span>
                                </p>
                                {# The grid loads each candidate's thumbnail where its source
                                   gave one (thumb falls back to url server-side); previewing
                                   and applying always use the full-resolution url. #}
                                <div class="find-grid">
                                    <template x-for="poster in section.posters" :key="poster.url">
                                        {# Each cell tracks its own image, so the shimmer stops per
                                           candidate as each thumbnail arrives. The DOM scan that
                                           does this for poster cards (initImages in gallery.js)
                                           cannot: Alpine creates and destroys these images on every
                                           search, long after that scan has run. `@error` resolves
                                           the cell too — a candidate whose image 404s must stop
                                           shimmering rather than promise one that is never coming. #}
                                        <figure class="find-item" x-data="{ loaded: false }">
                                            <div class="find-item__frame">
                                                <img class="find-item__img" :src="poster.thumb" alt="" loading="lazy"
                                                     :class="loaded ? 'is-loaded' : ''"
                                                     @load="loaded = true" @error="loaded = true"
                                                     @click="openPreview(poster.url, 'find', null, '', poster.page, section.label)" data-tooltip="Click to preview">
                                                {# The required credit, shown on a candidate whose supplying service's
                                                   licence compels the link, and on any other candidate the source
                                                   gave a page for. Both open where the poster came from, and they
                                                   are drawn identically — the licence asks that the link be shown,
                                                   not that it be shown differently from every other link.

                                                   **`attributionRequired` is named first, and that is not
                                                   decoration.**

                                                   Read the condition as two clauses that cannot be collapsed:
                                                   *always* when the licence requires it, *also* when we simply have
                                                   somewhere to point. The second clause is a product decision and
                                                   could be dropped tomorrow; the first cannot. Writing it this way
                                                   means dropping the provenance badge leaves
                                                   `x-show="poster.attributionRequired"` behind rather than removing
                                                   the credit that may not go. Reducing this to `poster.page` alone
                                                   would render identically today and lose that, silently.

                                                   `data-attribution-required` carries the same fact into the DOM, so
                                                   the distinction survives somewhere a reader can see it even though
                                                   both badges look alike.

                                                   Not `source === 'tvmaze'` in either clause — the payload
                                                   deliberately carries no source, because the service decides which
                                                   of its providers are licensed this way and a name test would have
                                                   to be reopened for the next one. TVmaze is simply the only one
                                                   marked today.

                                                   A sibling of the image rather than a wrapper: the image carries the
                                                   click that opens the preview, and wrapping it in an anchor would put
                                                   every candidate one stray press away from leaving the app. @click.stop
                                                   keeps the two apart in the other direction. Omitted entirely when
                                                   there is nothing to point at — never rendered disabled, since a
                                                   control that cannot exist has no state to announce. #}
                                                <a class="find-item__credit"
                                                   x-show="poster.attributionRequired || poster.page" x-cloak
                                                   :href="poster.page" target="_blank" rel="noopener"
                                                   @click.stop
                                                   :data-attribution-required="poster.attributionRequired ? 'true' : 'false'"
                                                   :aria-label="'Open this poster\'s page on ' + section.label"
                                                   :data-tooltip="'View on ' + section.label">↗</a>
                                            </div>
                                        </figure>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# The replacement shown full screen with a use/close choice and an inline
       confirm step, on both desktop and touch. Shared by all three tabs: a found
       candidate, a pasted URL, or the picked file rendered from the user's own
       device. Nothing here has posted anything yet — applyPreview() is the first
       and only request. #}
    {# Declared a dialog on the root rather than on an inner panel, because this
       overlay has no inner panel: the stage and the action bar are siblings, and
       the root is the only element that contains both. So one element is the
       backdrop, the dialog, and the focus target at once. That is unusual and it
       is correct — see the focus manager in gallery.js, which resolves a visible
       overlay's dialog as descendant-or-self for exactly this case.

       The role is new. This overlay has always behaved as a modal — backdrop,
       Escape, its own controls — while declaring nothing, which is why the two
       aria-disabled controls in the bar below were unreachable by keyboard: the
       manager had no way to know there was a dialog here to move focus into. #}
    <div class="viewer viewer--preview" x-show="preview.open" x-cloak
         role="dialog" aria-modal="true" aria-label="Preview poster" tabindex="-1"
         @click.self="closePreview()"
         @keydown.escape.window="closePreview()" style="display:none">
        {# The stage now covers the space beside the image, so it has to close the
           preview on its own account: without this, the only backdrop left that
           reaches the viewer's own handler is the strip around the action bar. #}
        <div class="viewer__stage" @click.self="closePreview()">
            <div class="viewer__placeholder" x-show="!preview.loaded"></div>
            {# `@error` resolves the preview rather than blocking it: a URL the
               browser cannot load may still be one the server can fetch, and the
               server is what decides. #}
            <img :src="preview.src" alt="" :class="preview.loaded ? 'is-loaded' : ''"
                 @load="preview.loaded = true" @error="preview.loaded = true">
        </div>
        <div class="viewer__bar">
            {# Where this poster came from. Shown for any candidate the source gave
               an address for, which is nearly all of them — this is provenance, and
               offering it is a product decision rather than a licence one.

               So the wording names the service and what the link opens, and says
               nothing about attribution or licensing. Most posters reaching this
               point are under no such condition, and a licence-flavoured phrase
               here would claim one on artwork that carries none.

               A candidate whose licence *does* compel the link is credited by the
               badge on the poster itself (see the find grid). That such a candidate
               also lands here is a consequence of it carrying an address, not the
               mechanism — this element is not what discharges the obligation, and
               removing it would not release anyone from one.

               Above the actions, not among them. It is not a choice about this
               poster — the row below is — and it stays put through the confirm
               step, which swaps that row out from under it. #}
            <a class="viewer__credit" x-show="preview.page" x-cloak
               :href="preview.page" target="_blank" rel="noopener"
               x-text="preview.service ? 'View on ' + preview.service : 'View source page'"></a>
            <div class="viewer__actions" x-show="!preview.confirming">
                <button type="button" class="btn btn--accent" @click="preview.confirming = true">Use this poster</button>
                <button type="button" class="btn" @click="closePreview()">Close</button>
            </div>
            {# The question stays short deliberately. Naming the poster here pushed
               it onto a second line, and the bar is bottom-anchored — so the stage
               above it shrank and the image the user is inspecting jumped at the
               moment they were deciding about it. The title is one Escape away in
               the dialog heading; a still image is worth more here. #}
            {# Both switch off the moment the change starts, and both use aria-disabled
               rather than disabled. The attribute drops a focused element out of the
               tab order, which hands the browser a focus it has nowhere to put: it
               falls to the document body, so a keyboard user who pressed Change poster
               loses their place mid-change. These are pressed and then switched off by
               that very press, so it is the common case here, not an edge one.

               applyPreview() already returns early on preview.applying (see gallery.js),
               so the accent button needs no guard added. Cancel is an inline expression
               with nothing behind it, so it tests the flag here — without that it would
               dismiss the confirm bar out from under a change already in flight. #}
            <div class="viewer__actions" x-show="preview.confirming" x-cloak>
                <span class="viewer__ask">Change the poster to this one?</span>
                <button type="button" class="btn btn--accent" @click="applyPreview()"
                        :aria-disabled="preview.applying ? 'true' : 'false'">Change poster</button>
                <button type="button" class="btn" @click="if (!preview.applying) preview.confirming = false"
                        :aria-disabled="preview.applying ? 'true' : 'false'">Cancel</button>
            </div>
        </div>
        {# Progress while the change runs. Shown immediately rather than after a
           grace period — the server has to take up or fetch the full-resolution
           image and push it to Plex, so this is never fast (see applyPreview).
           Full screen, not scoped to the change-poster panel: the preview above
           covers that panel, so an overlay confined to it would sit underneath
           the thing the user is looking at. `.overlay` is z-index 100 against
           the viewer's 60, so it lands on top with no new CSS. #}
        <div class="overlay" x-show="preview.applying" x-cloak style="display:none">
            <div class="overlay__box">
                <div class="spinner"></div>
                <p><strong>Changing poster&hellip;</strong></p>
                <p class="stats">Fetching the poster and sending it to Plex. Please keep this page open.</p>
            </div>
        </div>
    </div>

    {# Sort tray (phone): the same sort links as the desktop toolbar, presented as
       an app-style sheet to keep the toolbar uncluttered. #}
    <div class="sheet" x-show="sortOpen" x-cloak {{ tx.tray() }}
         @keydown.escape.window="sortOpen = false" style="display:none">
        <div class="sheet__backdrop" @click="sortOpen = false"></div>
        <div class="sheet__panel" role="dialog" aria-modal="true" aria-label="Sort order" tabindex="-1">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Sort</span></div>
            <div class="sheet__body menu__body">
                {{ sort_control.control(sort_state, base, sort_q) }}
            </div>
        </div>
    </div>

    {# Import tray (phone): the Import from Plex link opens this instead of
       navigating; its body is fetched from /plex and wired on first open. #}
    <div class="sheet" x-show="importOpen" x-cloak {{ tx.tray() }}
         @keydown.escape.window="closeImport()" style="display:none">
        <div class="sheet__backdrop" @click="closeImport()"></div>
        <div class="sheet__panel sheet__panel--tall" role="dialog" aria-modal="true" aria-label="Import from Plex" tabindex="-1">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Import from Plex</span></div>
            <div class="sheet__body">
                <p class="stats" x-show="importLoading">Loading…</p>
                <div x-ref="importBody" data-nested-scope></div>
            </div>
        </div>
    </div>

    {# Orphans tray (phone): the Orphans link opens this instead of navigating. Its
       body is the /orphans page content, fetched and wired on first open so its
       own scan/delete logic and (now tray-contained) progress overlays are reused. #}
    <div class="sheet" x-show="orphansOpen" x-cloak {{ tx.tray() }}
         @keydown.escape.window="closeOrphans()" style="display:none">
        <div class="sheet__backdrop" @click="closeOrphans()"></div>
        <div class="sheet__panel sheet__panel--tall" role="dialog" aria-modal="true" aria-label="Orphaned posters" tabindex="-1">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Orphaned posters</span></div>
            <div class="sheet__body" x-ref="orphansBody" data-nested-scope>
                <p class="stats" x-show="orphansLoading">Loading…</p>
            </div>
        </div>
    </div>

    {# Settings tray (phone): the Settings link opens this instead of navigating.
       Its body is the /settings page content, fetched on every open — the library
       list comes from Plex and the superseded-variable notice comes from the
       environment, so unlike the import form this one decays.

       Saving from here closes the tray and reloads the page rather than leaving it
       in place, because these settings change what is behind the tray: the site
       title in the header, how many posters a page holds, the order they are in,
       which libraries are visible. See saveSettings in gallery.js. #}
    <div class="sheet" x-show="settingsOpen" x-cloak {{ tx.tray() }}
         @keydown.escape.window="closeSettings()" style="display:none">
        <div class="sheet__backdrop" @click="closeSettings()"></div>
        <div class="sheet__panel sheet__panel--tall" role="dialog" aria-modal="true" aria-label="Settings" tabindex="-1">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Settings</span></div>
            <div class="sheet__body" x-ref="settingsBody" data-nested-scope>
                <p class="stats" x-show="settingsLoading">Loading…</p>
            </div>
            {# Pinned over the tray rather than the screen, by the shared z-index: 5
               demotion every tray's progress overlay takes. #}
            <div class="overlay" x-show="settingsSaving" x-cloak style="display:none">
                <div class="overlay__box">
                    <div class="spinner"></div>
                    <p><strong>Saving settings&hellip;</strong></p>
                </div>
            </div>
        </div>
    </div>

    {# Connection tray (phone): the Plex connection status opens this instead of
       navigating. Its body is the /connect page content, fetched on every open for
       a sharper reason than the settings tray's — that screen asks the Plex server
       its name when it renders, and the connection itself can have gone since the
       gallery behind this was drawn. See openConnect in gallery.js.

       Disconnecting from here is the one tray action that deliberately navigates.
       The form is a plain POST with no `js-mutate` class, so neither delegated
       handler touches it, and the browser follows its redirect to /connect. That is
       the point: disconnecting is what the connection gate turns a user away for,
       so closing back onto the gallery would strand them on a page that is about to
       bounce them anyway — without the confirmation. #}
    <div class="sheet" x-show="connectOpen" x-cloak {{ tx.tray() }}
         @keydown.escape.window="closeConnect()" style="display:none">
        <div class="sheet__backdrop" @click="closeConnect()"></div>
        <div class="sheet__panel sheet__panel--tall" role="dialog" aria-modal="true" aria-label="Plex Connection" tabindex="-1">
            <div class="sheet__grip"><span class="sheet__handle"></span></div>
            <div class="sheet__head"><span class="sheet__title">Plex Connection</span></div>
            <div class="sheet__body" x-ref="connectBody" data-nested-scope>
                <p class="stats" x-show="connectLoading">Loading…</p>
            </div>
        </div>
    </div>

    {# Shared confirm dialog, mobile action tray, fullscreen viewer, and toast. #}
    {% include 'partials/_overlays.html.twig' %}
</div>
{% endblock %}
