{% import 'partials/_nav_macros.html.twig' as nav %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    {# `interactive-widget=resizes-content` is load-bearing for the pinned mobile
       toolbar. Under the default (`resizes-visual`) an on-screen keyboard shrinks
       only the visual viewport, while `position: sticky` keeps resolving against
       the layout viewport — so with the keyboard up the pinned toolbar stays
       anchored above the visible area and scrolling pushes it out of view.
       Resizing the content instead makes the layout viewport the visible region,
       which is the coordinate space the sticky toolbar and the fixed bottom tab
       bar both need. Honoured by Chrome; iOS Safari ignores it, harmlessly. #}
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <meta name="theme-color" content="#1c1e24">
    {# Where the scripts read the token from. Forms carry it as a field; the
       fetch calls that build their own body have no form to draw from, so they
       send it as a header and take it from here. #}
    <meta name="csrf-token" content="{{ csrf_token() }}">
    {# Both names: iOS reads only the apple- one for a standalone home-screen
       install, and Chrome logs a deprecation warning for it unless the standard
       name is present too. #}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
    <title>{% block title %}{{ site_title }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('/assets/app.css') }}">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
    <script defer src="{{ asset('/assets/gallery.js') }}"></script>
    <script defer src="{{ asset('/assets/alpine.min.js') }}"></script>
    <script defer src="{{ asset('/assets/app.js') }}"></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">
            <svg class="brand__logo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <rect width="64" height="64" rx="12" fill="#1c1e24"/>
                <rect x="12" y="16" width="17" height="32" rx="3" fill="#b9800c" transform="rotate(-10 20.5 32)"/>
                <rect x="35" y="16" width="17" height="32" rx="3" fill="#b9800c" transform="rotate(10 43.5 32)"/>
                <rect x="21" y="15" width="22" height="34" rx="3" fill="#e5a00d"/>
                <path d="M27.80 26.98 L27.80 37.02 Q27.80 38.80 29.32 37.88 L37.59 32.85 Q39.00 32.00 37.59 31.15 L29.32 26.12 Q27.80 25.20 27.80 26.98 Z" fill="#1c1e24"/>
            </svg>
            <span>{{ site_title }}</span>
        </a>
        {% block nav %}
            {# The mobile menu (hamburger + tray) is always available so the
               secondary navigation stays reachable on a phone; only the Log out
               link is gated on being signed in. The sign-in screen overrides this
               block to empty, because nothing behind it is reachable yet. #}
            <div class="topnav" x-data="{ menuOpen: false, moreOpen: false }">
                {# The secondary actions live here rather than in any one page's
                   content, so they are reachable from every page that draws
                   navigation — the reach the tray already gives a phone. Import
                   and Orphans previously sat in the gallery toolbar, which left
                   /plex and /orphans with no navigation at all beyond their own
                   back link.

                   `nav_current` names the destination being viewed, set by that
                   page as a top-level {% verbatim %}{% set %}{% endverbatim %} —
                   Twig runs those before handing the context to this layout. It
                   suppresses the link that would point at the current page. #}
                <div class="topnav__desktop">
                    {{ nav.bar_links(nav_current|default('')) }}
                    {# Settings, Support and Log out, behind one control. The bar's
                       contents are aligned to the 960px content column and share it
                       with a brand of unbounded width, so all six labelled would not
                       reliably fit — see the split in _nav_macros.html.twig. #}
                    <div class="navmenu">
                        {# Marked current when the page being viewed is one the panel
                           holds, so putting an entry behind a click does not also
                           hide that you are on it. #}
                        <button type="button" x-ref="moreTrigger"
                                class="btn nav-item navmenu__trigger{{ nav.overflow_current_class(nav_current|default('')) }}"
                                @click="moreOpen = !moreOpen"
                                @click.outside="moreOpen = false"
                                @keydown.escape="moreOpen = false; $refs.moreTrigger.focus()"
                                :aria-expanded="moreOpen ? 'true' : 'false'"
                                aria-haspopup="menu" aria-label="More actions">
                            {{ nav.overflow_glyph(20) }}
                        </button>
                        {# Absolutely positioned, never fixed. The header carries
                           `backdrop-filter`, which makes it a containing block for
                           fixed descendants — the trap written up at length in
                           partials/_menu.html.twig, where it cost the phone tray a
                           teleport. An absolute panel resolves against .navmenu and
                           is unaffected.

                           Escape is bound on the panel as well as the trigger
                           because focus moves into the panel as soon as it is
                           opened from the keyboard. #}
                        <div class="navmenu__panel menu__body" x-show="moreOpen" x-cloak
                             role="menu" aria-label="More actions"
                             @keydown.escape="moreOpen = false; $refs.moreTrigger.focus()"
                             @click="moreOpen = false" style="display:none">
                            {{ nav.overflow_links(nav_current|default(''), signed_in()) }}
                        </div>
                    </div>
                    {% if signed_in() %}
                        {{ nav.connection_status(plex_connection(), nav_current|default('')) }}
                    {% endif %}
                </div>
                {# An overflow ("more") glyph rather than a hamburger: nothing behind
                   this button navigates in place on a phone — Import, Orphans and
                   Settings open as trays over the current page, Poster Wall and
                   Support open new tabs, and Log out is an action. A hamburger would
                   promise the edge-anchored navigation drawer this menu deliberately
                   isn't. The same mark names the desktop overflow above. #}
                <button type="button" class="menu-btn" @click="menuOpen = true"
                        aria-label="Actions" aria-haspopup="true">
                    {{ nav.overflow_glyph(24) }}
                </button>
                {% include 'partials/_menu.html.twig' %}
            </div>
        {% endblock %}
    </header>
    <main class="container">
        {% block content %}{% endblock %}
    </main>
    <footer class="footer">
        {% include 'partials/_attribution.html.twig' %}
        <div><a href="https://getmarquee.now" target="_blank"
                rel="noopener">{{ app_name }}</a> &middot; v{{ app_version }}<span class="js-update-note"></span></div>
    </footer>
</body>
</html>
