{% import 'partials/_nav_macros.html.twig' as nav %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1c1e24">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ app_name }}">
    <title>{% block title %}{{ site_title }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('/assets/app.css') }}">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
    <script defer src="{{ asset('/assets/gallery.js') }}"></script>
    <script defer src="{{ asset('/assets/alpine.min.js') }}"></script>
    <script defer src="{{ asset('/assets/app.js') }}"></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">
            <svg class="brand__logo" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <rect width="64" height="64" rx="12" fill="#1c1e24"/>
                <rect x="12" y="16" width="17" height="32" rx="3" fill="#b9800c" transform="rotate(-10 20.5 32)"/>
                <rect x="35" y="16" width="17" height="32" rx="3" fill="#b9800c" transform="rotate(10 43.5 32)"/>
                <rect x="21" y="15" width="22" height="34" rx="3" fill="#e5a00d"/>
                <path d="M27.8 25.2 L27.8 38.8 L39 32 Z" fill="#1c1e24" stroke-linejoin="round"/>
            </svg>
            <span>{{ site_title }}</span>
        </a>
        {% block nav %}
            {# The mobile menu (hamburger + tray) is always available so the
               secondary navigation stays reachable on a phone even when auth is
               bypassed; only the Log out link is gated on auth_bypass. Pages with
               no navigation (login) override this block to empty. #}
            <div class="topnav" x-data="{ menuOpen: false }">
                {% if not auth_bypass %}
                    <span class="topnav__desktop">{{ nav.logout_link() }}</span>
                {% endif %}
                <button type="button" class="menu-btn" @click="menuOpen = true"
                        aria-label="Menu" aria-haspopup="true">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                        <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor"
                              stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </button>
                {% include 'partials/_menu.html.twig' %}
            </div>
        {% endblock %}
    </header>
    <main class="container">
        {% block content %}{% endblock %}
    </main>
    <footer class="footer"><a href="https://marquee.dumbprojects.com" target="_blank"
            rel="noopener">{{ app_name }}</a> &middot; v{{ app_version }}<span class="js-update-note"></span></footer>
</body>
</html>
