{# Shared overlays: confirm dialog, mobile action tray, fullscreen viewer, toast.
   Included by any page whose Alpine root mixes in the overlay component
   (galleryUI, orphansPage) — they expose the same state (confirm, sheet, viewer,
   toast) and methods (doConfirm, closeSheet, notify), so this markup is shared. #}

{% import 'partials/_transitions.html.twig' as tx %}

{# Confirm modal #}
<div class="modal" x-show="confirm.open" x-cloak {{ tx.dialog() }}
     @keydown.escape.window="confirm.open = false" style="display:none">
    <div class="modal__backdrop" @click="confirm.open = false"></div>
    <div class="modal__panel modal__panel--narrow" role="dialog" aria-modal="true" aria-label="Confirm" tabindex="-1">
        {# Grab handle: hidden on desktop, the drag-to-dismiss target on a phone.
           It must be a real element, not a pseudo-element, because touch can only
           target elements — and it must be a *different* element from the panel's
           scrolling body, so `touch-action: none` can claim a downward drag
           without also disabling the scroll. That separation is the whole reason
           the trays dismiss cleanly; see initSheetGestures in gallery.js. #}
        <div class="sheet__grip"><span class="sheet__handle"></span></div>
        <div class="modal__head">
            <h2 x-text="confirm.title"></h2>
            <button type="button" class="modal__close" @click="confirm.open = false" aria-label="Close">&times;</button>
        </div>
        <div class="modal__body">
            <p class="stats" x-text="confirm.message"></p>
            <div class="modal__actions">
                <button type="button" class="btn" @click="confirm.open = false">Cancel</button>
                {# The confirming button's emphasis comes from the action being
                   confirmed, not from the dialog: red is reserved for removing a
                   poster, so an overwrite (Send to Plex, Fetch from Plex) is not
                   offered under a button that reads as Delete. #}
                <button type="button" class="btn" :class="confirm.tone === 'danger' ? 'btn--danger' : 'btn--accent'"
                        @click="doConfirm()" x-text="confirm.label"></button>
            </div>
        </div>
    </div>
</div>

{# Mobile action sheet: holds a tapped poster's actions at full size.
   Escape unwinds one layer at a time. A confirmation raised from this tray is
   rendered above it and leaves it standing, so an unguarded handler here would
   close the tray out from under a confirmation the user is still answering —
   the same guard the change dialog carries. #}
<div class="sheet" x-show="sheet.open" x-cloak {{ tx.tray() }}
     @keydown.escape.window="if (!confirm.open) closeSheet()" style="display:none">
    <div class="sheet__backdrop" @click="closeSheet()"></div>
    <div class="sheet__panel" role="dialog" aria-modal="true" aria-label="Poster actions" tabindex="-1">
        <div class="sheet__grip"><span class="sheet__handle"></span></div>
        <div class="sheet__head">
            <span class="sheet__title" x-text="sheet.title"></span>
        </div>
        <div class="sheet__body" x-html="sheet.actions"></div>
    </div>
</div>

{# Fullscreen viewer. The placeholder holds the poster's place while the image
   loads — it is a real element, not the ::before the cards use, because a
   full-screen image is sized by its own dimensions and has no frame to fill.
   Both it and the fade are driven by viewerLoaded, which view() clears on every
   open; see overlayComponent in gallery.js.

   Declares no `role="dialog"`, and that is a decision rather than an oversight —
   DialogFocusTest pins it. The focus manager takes its subjects from that
   attribute, and this overlay holds nothing to focus: a poster with `alt=""`, no
   controls, and no close affordance beyond clicking anywhere or pressing Escape.
   Moving focus here would move it nowhere, and keeping it here would keep it on
   an element the user cannot act on.

   That is not the same as saying this overlay is fine. A keyboard user meets an
   unannounced image that Escape happens to dismiss, and a screen reader user
   meets nothing at all. Fixing it means giving it a name and a visible close
   control, which changes what is on the screen — a poster-library decision, not
   a focus one. Until that is made, leaving the attribute off is what keeps the
   manager honest about having nowhere to put focus. #}
<div class="viewer" x-show="viewer" x-cloak @click="viewer = null"
     @keydown.escape.window="viewer = null" style="display:none">
    <div class="viewer__stage">
        <div class="viewer__placeholder" x-show="!viewerLoaded"></div>
        <img :src="viewer" alt="" :class="viewerLoaded ? 'is-loaded' : ''"
             @load="viewerLoaded = true" @error="viewerLoaded = true">
    </div>
</div>

{# Toast #}
<div class="toast" x-show="toast.show" x-cloak style="display:none" x-text="toast.text"></div>
