{# View-level base drives pagination over the whole (combined or category) list. #}
{% set base = '/library/' ~ view.value %}

{# One action control. The icon leads and is hidden from assistive technology —
   the label is what names the control, here and in the touch action sheet, which
   renders this same markup. 18px against the 0.8rem line box, so the row's height
   is set by the text as it was before icons: the stack must not grow (see
   "Poster cards fit their full action stack"). #}
{% macro action_body(glyph, label) %}
    {% import 'partials/_icons.html.twig' as icons %}
    <span class="card__action-ico" aria-hidden="true">{{ icons.icon(glyph, 18) }}</span>
    <span class="card__action-label">{{ label }}</span>
{% endmacro %}

{% if set_key is defined and set_key is not empty %}
    {# A set: the posters recorded as belonging to one Plex item — a show with its
       seasons, a collection with its films. Named where it can be; the item that
       names it may have no imported poster of its own, and the set is still
       correct without a name. Its clear control returns to the unfiltered view,
       exactly as the search's does, so the two filtered states behave alike. #}
    <div class="stats stats--filter">
        <span>
            {% if result.total > 0 %}
                {{ result.total }} {{ result.total == 1 ? 'poster' : 'posters' }}
                {%- if set_title %} in {{ set_title }}{% else %} in this set{% endif %}
            {% else %}
                Nothing else in this set
            {% endif %}
        </span>
        <a class="search__clear" href="/library/{{ view.value }}">Clear</a>
    </div>
    {% if result.broaderQuery %}
        {# A set can be narrower than the library and say nothing about it: a
           Plex collection holds what somebody put in it, so a collection of
           eight where the library holds nine is what a film never added looks
           like. Membership being exact is not the same as the collection being
           complete, which is why "an exact set is offered nothing" was the wrong
           rule.

           Worded for its own question. The search's offer asks "did you mean
           something broader?"; this asks "is something missing from this
           collection?" — and only appears when a shorter query would find MORE
           posters than the set holds, which is what keeps it quiet for a show's
           seasons and for a collection whose films share no words. #}
        <p class="stats stats--suggest">
            Missing something?
            <a href="/library/{{ view.value }}?q={{ result.broaderQuery|url_encode }}">Searching
                “{{ result.broaderQuery }}” finds {{ result.broaderTotal }}</a>
        </p>
    {% endif %}
    {% if also_in is defined and also_in is not empty %}
        {# The poster this set was opened from belongs to other sets too, and
           without this the user has no way to know. "Godzilla vs. Kong" is in
           both King Kong and MonsterVerse; the card's link had to pick one, and
           picked silently.

           These are the ORIGIN poster's other sets, not the union over every
           member — a film in a large collection commonly belongs to several
           others, and listing all of those answers a question nobody asked.

           Each link carries the same origin poster, so a film in several
           collections can be followed from any one of them to any other. A set
           whose name is not known yet is described rather than dropped: the link
           is the useful part, the name is the courtesy. #}
        <p class="stats stats--suggest">
            Also in
            {%- for other in also_in %}
                {{ loop.first ? '' : (loop.last ? ' and' : ',') }}
                <a href="/library/{{ view.value }}?set={{ other.key|url_encode }}{{ set_from is not empty ? '&from=' ~ set_from|url_encode : '' }}">{{
                    other.title ?? 'another set' }}</a>
            {%- endfor %}.
        </p>
    {% endif %}
{% elseif query is not empty %}
    {# A search is active: name the query and its match count for THIS view, and
       offer a clear control so the filtered state is unmistakable. #}
    <div class="stats stats--filter">
        <span>
            {% if result.total > 0 %}
                {{ result.total }} {{ result.total == 1 ? 'match' : 'matches' }} for “{{ query }}” in {{ view.label }}
            {% else %}
                No matches for “{{ query }}” in {{ view.label }}
            {% endif %}
        </span>
        <a class="search__clear" href="/library/{{ view.value }}">Clear search</a>
    </div>
    {% if result.broaderQuery %}
        {# A way out of the narrow result a library without Plex collections gets.
           Related posters shows the set a poster belongs to, and a film in no
           collection has none, so the action falls back to searching that film's
           own title — which reaches the rest of a series only from the shortest
           title in it. "The Matrix" finds its sequels; "The Matrix Reloaded"
           finds itself.

           OFFERED, NEVER APPLIED. The cut behind it is a guess, and a guess is
           only acceptable here because the reader makes it: the count travels
           with the link, so a candidate far too broad says so before anyone
           follows it. Nothing widens a search on its own. #}
        <p class="stats stats--suggest">
            Looking for the rest of a series?
            <a href="/library/{{ view.value }}?q={{ result.broaderQuery|url_encode }}">Try
                “{{ result.broaderQuery }}” ({{ result.broaderTotal }} matches)</a>
        </p>
    {% endif %}
{% else %}
    <p class="stats">
        {% if result.total > 0 %}
            {# Two reports; exactly one is ever shown. A range describes a page,
               so it belongs with the pager — and the pager is a pointer-screen
               control. A narrow screen loads by infinite scroll, where a range
               of one page is a fiction that also goes stale the moment a batch
               is appended: the grid grows and this line does not. It reports the
               size of the category there, which is true on arrival and stays
               true however far the reader scrolls.

               Which one is shown is decided in app.css, in the same
               `max-width: 640px` block that hides .pagination. Not here: the
               server cannot see the viewport, and a window resized across the
               threshold has to follow without a reload. `display: none` also
               drops the other from the accessibility tree, so a screen reader
               hears one report rather than two. #}
            <span class="stats__range">Showing {{ result.firstItemNumber }}–{{ result.lastItemNumber }} of {{ result.total }}</span>
            <span class="stats__total">Total: {{ result.total }}</span>
        {% else %}
            No posters yet — import from Plex to get started.
        {% endif %}
    </p>
{% endif %}

<div class="grid" data-page="{{ result.page }}" data-total-pages="{{ result.totalPages }}">
    {% for poster in result.items %}
        {# Actions target the poster's OWN category: filenames are unique only
           within a category, so the page-level base is wrong in the All view. #}
        {% set poster_base = '/library/' ~ poster.category.value %}
        {# Everything recorded about this poster, read once for the whole view.
           `mapped` is the mapping's existence; linked is that AND a live
           connection, because the actions a link enables need the server. #}
        {% set poster_facts = facts.for(poster) %}
        {% set is_linked = plex_configured and poster_facts.mapped %}
        {# One title serves every place this poster is named: the caption, its
           tooltip, the alt text, the mobile sheet, the change-poster dialog, and
           the delete confirmation. It comes from Plex, with the known year in
           parentheses. Either may be null (a poster with no Plex record, a
           collection with no year), and captionTitle falls back accordingly. #}
        {% set poster_title = poster_facts.title %}
        {% set poster_year = poster_facts.year %}
        {% set caption_title = poster.captionTitle(poster_title, poster_year) %}
        {# What Related posters searches for. A season answers with its show's
           title, so the search gathers the show and every sibling season rather
           than the one season it started from; everything else answers with its
           own. Falls back to the filename-derived title for a poster with no Plex
           record — narrow, never wrong.

           Deliberately NOT caption_title: that appends the release year, and a
           query carrying "(1999)" would narrow the search back to this one
           poster, which is the opposite of the point. #}
        {% set related_query = facts.relatedTitleFor(poster) %}
        {# The set this poster belongs to, recorded at import: a show's or a
           collection's rating key. It is the whole point of the action — a title
           cannot express a collection whose films share no words ("Iron Man",
           "Thor"), and cannot tell two works apart that share one.

           Empty for a movie in no collection, for a poster with no Plex record,
           and for the window before the first import that records sets. Those
           fall back to the title search above, so nothing that worked before
           stops working. #}
        {# The sets this poster belongs to. A film can be in several collections,
           so the link opens the first — the poster it was activated from is in
           every one of them, and a single link has to choose. The set VIEW then
           matches on membership, so opening a collection's own poster gathers
           every film listing that collection, including films that also belong to
           another.

           `from` is what stops that choice being silent. It names the poster the
           set was opened from, so the destination can say "…is also in
           MonsterVerse" and link there. It is optional and decides nothing about
           which posters the set holds — a set address without it renders exactly
           as it always did — which is why the link can carry it without the
           destination depending on it. #}
        {% set related_sets = poster_facts.setKeys %}
        {% set related_set = related_sets is not empty ? related_sets|first : '' %}
        {% set related_from = poster.category.value ~ '/' ~ poster.filename %}
        {% set related_href = related_set is not empty
            ? '/library/all?set=' ~ related_set|url_encode ~ '&from=' ~ related_from|url_encode
            : '/library/all?q=' ~ related_query|url_encode %}
        <figure class="card">
            <div class="card__frame">
                <img class="card__image" src="{{ poster.url }}" alt="{{ caption_title }}" loading="lazy">
                {% if is_all_view %}
                    <span class="card__badge card__badge--{{ poster.category.value }}">{{ poster.category.badgeLabel }}</span>
                {% endif %}
                <div class="card__overlay">
                    <div class="card__actions">
                        <button type="button" class="btn btn--small btn--accent"
                                data-action="change" data-filename="{{ poster.filename }}"
                                data-title="{{ caption_title }}" data-category="{{ poster.category.value }}"
                                {# Lets the change dialog disable its Plex Posters tab without
                                   first asking Plex about a poster it already knows is unlinked. #}
                                data-linked="{{ is_linked ? '1' : '' }}">
                            {{ _self.action_body('change', 'Change poster') }}
                        </button>
                        {# data-refresh tells the gallery script how much of the grid a
                           mutation invalidates. `none`: nothing stored changed, so there
                           is nothing to re-render. `card`: exactly one poster's image was
                           replaced, so only that card is rebuilt and the grid — with the
                           user's place in it — is left alone; data-category pairs with the
                           posted filename to find it. Saying nothing (Delete) means the
                           whole grid, which is the safe default for anything that changes
                           WHICH posters exist and therefore the counts and pagination. #}
                        {# Both Plex actions overwrite something that cannot be
                           recovered — Send replaces the artwork on the Plex item,
                           Fetch discards the poster stored here — so each states
                           in its own words which copy it is about to overwrite.
                           They sit side by side and move the same image in
                           opposite directions, which is exactly what makes a
                           mis-tap plausible and a shared wording useless. The
                           tone keeps red for Delete alone. #}
                        {% if is_linked %}
                            <form class="js-mutate" method="post" action="{{ poster_base }}/send-to-plex"
                                  data-refresh="none"
                                  data-confirm="Replace the artwork on Plex for “{{ caption_title }}” with Marquee's copy, and lock it?"
                                  data-confirm-title="Send to Plex?"
                                  data-confirm-label="Send to Plex"
                                  data-confirm-tone="accent">
                                {{ csrf_field() }}
                                <input type="hidden" name="filename" value="{{ poster.filename }}">
                                <button type="submit" class="btn btn--small">{{ _self.action_body('send', 'Send to Plex') }}</button>
                            </form>
                            <form class="js-mutate" method="post" action="{{ poster_base }}/fetch-from-plex"
                                  data-refresh="card" data-category="{{ poster.category.value }}"
                                  data-confirm="Replace Marquee's poster for “{{ caption_title }}” with the artwork currently in Plex? This overwrites the stored poster."
                                  data-confirm-title="Fetch from Plex?"
                                  data-confirm-label="Fetch from Plex"
                                  data-confirm-tone="accent">
                                {{ csrf_field() }}
                                <input type="hidden" name="filename" value="{{ poster.filename }}">
                                <button type="submit" class="btn btn--small">{{ _self.action_body('fetch', 'Fetch from Plex') }}</button>
                            </form>
                        {% endif %}
                        <a class="btn btn--small" href="{{ poster.url }}" download>{{ _self.action_body('download', 'Download') }}</a>
                        {# An anchor rather than a button, like Download above it. With no
                           JavaScript this is a working full page load to the filtered view;
                           with it, the gallery intercepts the click and switches view without
                           a reload. Being a real link, it can also be middle-clicked, opened
                           in a new tab, and copied — which is a more useful "copy" than the
                           Copy URL action it replaced, whose address only ever resolved
                           inside the session that produced it.

                           data-related carries the query rather than the handler re-deriving
                           it from the href, so the one place it is decided is above. #}
                        <a class="btn btn--small" href="{{ related_href }}"
                           data-related="{{ related_query }}"
                           data-related-set="{{ related_set }}"
                           data-related-from="{{ related_from }}">{{ _self.action_body('related', 'Related posters') }}</a>
                        <button type="button" class="btn btn--small" data-action="view" data-url="{{ poster.url }}">{{ _self.action_body('fullscreen', 'Full screen') }}</button>
                        <form class="js-mutate" method="post" action="{{ poster_base }}/delete"
                              data-confirm="Permanently delete “{{ caption_title }}”? This cannot be undone.">
                            {{ csrf_field() }}
                            <input type="hidden" name="filename" value="{{ poster.filename }}">
                            <button type="submit" class="btn btn--small btn--danger">{{ _self.action_body('delete', 'Delete') }}</button>
                        </form>
                    </div>
                </div>
            </div>
            {# data-tooltip-truncated: the tooltip only restates this caption, so
               it is shown only while the title is too long to fit. #}
            <figcaption class="card__caption" data-tooltip="{{ caption_title }}" data-tooltip-truncated>{{ caption_title }}</figcaption>
        </figure>
    {% endfor %}
</div>

{% if result.totalPages > 1 %}
    {% set q = query is not empty ? '&q=' ~ query|url_encode : '' %}
    {# Carry the current sort so paging keeps the chosen order, whatever it is.
       Testing for a non-default slug and leaving it off otherwise is how a
       reversed order silently resets itself on the way to page two. #}
    {% set q = q ~ (sort is defined ? '&sort=' ~ sort : '') %}
    <nav class="pagination" aria-label="Gallery pages">
        {% if result.hasPrevious %}
            <a class="btn pagination__step" href="{{ base }}?page=1{{ q }}" aria-label="First page" data-tooltip="First page">&laquo;</a>
            <a class="btn pagination__step" href="{{ base }}?page={{ result.page - 1 }}{{ q }}" aria-label="Previous page" data-tooltip="Previous page">&lsaquo;</a>
        {% endif %}
        <ol class="pagination__pages">
            {% for token in result.paginationWindow %}
                {% if token is null %}
                    <li class="pagination__ellipsis" aria-hidden="true">&hellip;</li>
                {% elseif token == result.page %}
                    <li><span class="pagination__page pagination__page--current" aria-current="page">{{ token }}</span></li>
                {% else %}
                    <li><a class="pagination__page" href="{{ base }}?page={{ token }}{{ q }}">{{ token }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
        {% if result.hasNext %}
            <a class="btn pagination__step" href="{{ base }}?page={{ result.page + 1 }}{{ q }}" aria-label="Next page" data-tooltip="Next page">&rsaquo;</a>
            <a class="btn pagination__step" href="{{ base }}?page={{ result.totalPages }}{{ q }}" aria-label="Last page" data-tooltip="Last page">&raquo;</a>
        {% endif %}
    </nav>
{% endif %}
