{# View-level base drives pagination over the whole (combined or category) list. #}
{% set base = '/library/' ~ view.value %}

{# One action control. The icon leads and is hidden from assistive technology —
   the label is what names the control, here and in the touch action sheet, which
   renders this same markup. 18px against the 0.8rem line box, so the row's height
   is set by the text as it was before icons: the stack must not grow (see
   "Poster cards fit their full action stack"). #}
{% macro action_body(glyph, label) %}
    {% import 'partials/_icons.html.twig' as icons %}
    <span class="card__action-ico" aria-hidden="true">{{ icons.icon(glyph, 18) }}</span>
    <span class="card__action-label">{{ label }}</span>
{% endmacro %}

{% if query is not empty %}
    {# A search is active: name the query and its match count for THIS view, and
       offer a clear control so the filtered state is unmistakable. #}
    <div class="stats stats--filter">
        <span>
            {% if result.total > 0 %}
                {{ result.total }} {{ result.total == 1 ? 'match' : 'matches' }} for “{{ query }}” in {{ view.label }}
            {% else %}
                No matches for “{{ query }}” in {{ view.label }}
            {% endif %}
        </span>
        <a class="search__clear" href="/library/{{ view.value }}">Clear search</a>
    </div>
{% else %}
    <p class="stats">
        {% if result.total > 0 %}
            {# Two reports; exactly one is ever shown. A range describes a page,
               so it belongs with the pager — and the pager is a pointer-screen
               control. A narrow screen loads by infinite scroll, where a range
               of one page is a fiction that also goes stale the moment a batch
               is appended: the grid grows and this line does not. It reports the
               size of the category there, which is true on arrival and stays
               true however far the reader scrolls.

               Which one is shown is decided in app.css, in the same
               `max-width: 640px` block that hides .pagination. Not here: the
               server cannot see the viewport, and a window resized across the
               threshold has to follow without a reload. `display: none` also
               drops the other from the accessibility tree, so a screen reader
               hears one report rather than two. #}
            <span class="stats__range">Showing {{ result.firstItemNumber }}–{{ result.lastItemNumber }} of {{ result.total }}</span>
            <span class="stats__total">Total: {{ result.total }}</span>
        {% else %}
            No posters yet — import from Plex to get started.
        {% endif %}
    </p>
{% endif %}

<div class="grid" data-page="{{ result.page }}" data-total-pages="{{ result.totalPages }}">
    {% for poster in result.items %}
        {# Actions target the poster's OWN category: filenames are unique only
           within a category, so the page-level base is wrong in the All view. #}
        {% set poster_base = '/library/' ~ poster.category.value %}
        {% set is_linked = plex_configured and poster.filename in (linked[poster.category.value] ?? []) %}
        {# One title serves every place this poster is named: the caption, its
           tooltip, the alt text, the mobile sheet, the change-poster dialog, and
           the delete confirmation. It comes from Plex, with the known year in
           parentheses. Either may be null (a poster with no Plex record, a
           collection with no year), and captionTitle falls back accordingly. #}
        {% set poster_title = (plex_titles[poster.category.value] ?? {})[poster.filename] ?? null %}
        {% set poster_year = (plex_years[poster.category.value] ?? {})[poster.filename] ?? null %}
        {% set caption_title = poster.captionTitle(poster_title, poster_year) %}
        <figure class="card">
            <div class="card__frame">
                <img class="card__image" src="{{ poster.url }}" alt="{{ caption_title }}" loading="lazy">
                {% if is_all_view %}
                    <span class="card__badge card__badge--{{ poster.category.value }}">{{ poster.category.badgeLabel }}</span>
                {% endif %}
                <div class="card__overlay">
                    <div class="card__actions">
                        <button type="button" class="btn btn--small btn--accent"
                                data-action="change" data-filename="{{ poster.filename }}"
                                data-title="{{ caption_title }}" data-category="{{ poster.category.value }}"
                                {# Lets the change dialog disable its Plex Posters tab without
                                   first asking Plex about a poster it already knows is unlinked. #}
                                data-linked="{{ is_linked ? '1' : '' }}">
                            {{ _self.action_body('change', 'Change poster') }}
                        </button>
                        {# data-refresh tells the gallery script how much of the grid a
                           mutation invalidates. `none`: nothing stored changed, so there
                           is nothing to re-render. `card`: exactly one poster's image was
                           replaced, so only that card is rebuilt and the grid — with the
                           user's place in it — is left alone; data-category pairs with the
                           posted filename to find it. Saying nothing (Delete) means the
                           whole grid, which is the safe default for anything that changes
                           WHICH posters exist and therefore the counts and pagination. #}
                        {# Both Plex actions overwrite something that cannot be
                           recovered — Send replaces the artwork on the Plex item,
                           Fetch discards the poster stored here — so each states
                           in its own words which copy it is about to overwrite.
                           They sit side by side and move the same image in
                           opposite directions, which is exactly what makes a
                           mis-tap plausible and a shared wording useless. The
                           tone keeps red for Delete alone. #}
                        {% if is_linked %}
                            <form class="js-mutate" method="post" action="{{ poster_base }}/send-to-plex"
                                  data-refresh="none"
                                  data-confirm="Replace the artwork on Plex for “{{ caption_title }}” with Marquee's copy, and lock it?"
                                  data-confirm-title="Send to Plex?"
                                  data-confirm-label="Send to Plex"
                                  data-confirm-tone="accent">
                                {{ csrf_field() }}
                                <input type="hidden" name="filename" value="{{ poster.filename }}">
                                <button type="submit" class="btn btn--small">{{ _self.action_body('send', 'Send to Plex') }}</button>
                            </form>
                            <form class="js-mutate" method="post" action="{{ poster_base }}/fetch-from-plex"
                                  data-refresh="card" data-category="{{ poster.category.value }}"
                                  data-confirm="Replace Marquee's poster for “{{ caption_title }}” with the artwork currently in Plex? This overwrites the stored poster."
                                  data-confirm-title="Fetch from Plex?"
                                  data-confirm-label="Fetch from Plex"
                                  data-confirm-tone="accent">
                                {{ csrf_field() }}
                                <input type="hidden" name="filename" value="{{ poster.filename }}">
                                <button type="submit" class="btn btn--small">{{ _self.action_body('fetch', 'Fetch from Plex') }}</button>
                            </form>
                        {% endif %}
                        <a class="btn btn--small" href="{{ poster.url }}" download>{{ _self.action_body('download', 'Download') }}</a>
                        <button type="button" class="btn btn--small" data-action="copy" data-url="{{ poster.url }}">{{ _self.action_body('copy', 'Copy URL') }}</button>
                        <button type="button" class="btn btn--small" data-action="view" data-url="{{ poster.url }}">{{ _self.action_body('fullscreen', 'Full screen') }}</button>
                        <form class="js-mutate" method="post" action="{{ poster_base }}/delete"
                              data-confirm="Permanently delete “{{ caption_title }}”? This cannot be undone.">
                            {{ csrf_field() }}
                            <input type="hidden" name="filename" value="{{ poster.filename }}">
                            <button type="submit" class="btn btn--small btn--danger">{{ _self.action_body('delete', 'Delete') }}</button>
                        </form>
                    </div>
                </div>
            </div>
            {# data-tooltip-truncated: the tooltip only restates this caption, so
               it is shown only while the title is too long to fit. #}
            <figcaption class="card__caption" data-tooltip="{{ caption_title }}" data-tooltip-truncated>{{ caption_title }}</figcaption>
        </figure>
    {% endfor %}
</div>

{% if result.totalPages > 1 %}
    {% set q = query is not empty ? '&q=' ~ query|url_encode : '' %}
    {# Carry the current sort so paging keeps the chosen order, whatever it is.
       Testing for a non-default slug and leaving it off otherwise is how a
       reversed order silently resets itself on the way to page two. #}
    {% set q = q ~ (sort is defined ? '&sort=' ~ sort : '') %}
    <nav class="pagination" aria-label="Gallery pages">
        {% if result.hasPrevious %}
            <a class="btn pagination__step" href="{{ base }}?page=1{{ q }}" aria-label="First page" data-tooltip="First page">&laquo;</a>
            <a class="btn pagination__step" href="{{ base }}?page={{ result.page - 1 }}{{ q }}" aria-label="Previous page" data-tooltip="Previous page">&lsaquo;</a>
        {% endif %}
        <ol class="pagination__pages">
            {% for token in result.paginationWindow %}
                {% if token is null %}
                    <li class="pagination__ellipsis" aria-hidden="true">&hellip;</li>
                {% elseif token == result.page %}
                    <li><span class="pagination__page pagination__page--current" aria-current="page">{{ token }}</span></li>
                {% else %}
                    <li><a class="pagination__page" href="{{ base }}?page={{ token }}{{ q }}">{{ token }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
        {% if result.hasNext %}
            <a class="btn pagination__step" href="{{ base }}?page={{ result.page + 1 }}{{ q }}" aria-label="Next page" data-tooltip="Next page">&rsaquo;</a>
            <a class="btn pagination__step" href="{{ base }}?page={{ result.totalPages }}{{ q }}" aria-label="Last page" data-tooltip="Last page">&raquo;</a>
        {% endif %}
    </nav>
{% endif %}
