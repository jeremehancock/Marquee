{#
    The Plex connection panel.

    Four states, and the third is the one that must not be softened: a stored
    sign-in that PLEX_TOKEN is overriding. Showing it as a plain "signed in"
    would leave a user to discover, only after removing the variable and
    restarting, that the stored token was never completed or belongs to another
    account.
#}
<div class="panel plex-connection" x-data="plexConnection()">
    {% if connection.isConnected %}
        <p class="plex-connection__server">
            <strong>Connected to {{ connection.serverName ?? 'Plex' }}</strong>
        </p>

        {% if connection.isSignedIn %}
            <p class="plex-connection__source">Signed in to Plex.</p>
            <form method="post" action="/plex/connection/sign-out">
                <button type="submit" class="button button--quiet">Sign out of Plex</button>
            </form>
        {% elseif connection.isOverridden %}
            <p class="plex-connection__source">
                Using <code>PLEX_TOKEN</code> from your environment.
                <strong>Your Plex sign-in is stored but not in use</strong> —
                <code>PLEX_TOKEN</code> takes precedence.
            </p>
            <p class="plex-connection__hint">
                Remove <code>PLEX_TOKEN</code> from your compose file and restart
                Marquee to use the sign-in instead.
            </p>
            <form method="post" action="/plex/connection/sign-out">
                <button type="submit" class="button button--quiet">Discard the stored sign-in</button>
            </form>
        {% else %}
            <p class="plex-connection__source">Using <code>PLEX_TOKEN</code> from your environment.</p>
            <p class="plex-connection__hint">
                You can sign in to Plex instead, which stores the token in
                <code>/config</code> so you can drop <code>PLEX_TOKEN</code> from
                your compose file.
            </p>
            <button type="button" class="button button--quiet"
                    @click="signIn()" x-bind:disabled="busy"
                    x-text="busy ? 'Waiting for Plex…' : 'Sign in to Plex instead'">Sign in to Plex instead</button>
        {% endif %}
    {% elseif connection.needsServerUrl %}
        <p><strong>Plex is not connected.</strong></p>
        <p>
            Marquee has a Plex credential but no server address. Set
            <code>PLEX_SERVER_URL</code> in your environment and restart —
            signing in again will not supply it.
        </p>
    {% else %}
        <p><strong>Plex is not connected.</strong></p>
        <p>
            Sign in to Plex to let Marquee import and update your posters. Set
            <code>PLEX_SERVER_URL</code> to your server's address first if you
            have not already.
        </p>
        <button type="button" class="button"
                @click="signIn()" x-bind:disabled="busy"
                x-text="busy ? 'Waiting for Plex…' : 'Sign in to Plex'">Sign in to Plex</button>
    {% endif %}

    {# Shown only when the popup was blocked, so the flow still completes. #}
    <p class="plex-connection__fallback" x-show="fallbackUrl" x-cloak>
        Your browser blocked the Plex window.
        <a x-bind:href="fallbackUrl" target="_blank" rel="noopener">Open Plex sign-in</a>
    </p>

    <p class="plex-connection__message" x-show="message" x-cloak x-text="message"></p>

    <p class="plex-connection__docs">
        <a href="https://github.com/jeremehancock/Marquee/blob/main/docs/plex-connection.md"
           target="_blank" rel="noopener">What's the difference?</a>
    </p>
</div>
