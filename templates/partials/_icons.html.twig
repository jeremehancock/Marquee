        'wall': '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9.3l4.5 2.7-4.5 2.7z"/>',
        'connect': '<path d="M9 15l-2.5 2.5a3.5 3.5 0 0 1-5-5L4 10"/><path d="M15 9l2.5-2.5a3.5 3.5 0 0 1 5 5L20 14"/><path d="M9.5 14.5l5-5"/>',
        'import': '<path d="M3 12h11"/><path d="M10 16l4-4-4-4"/><path d="M20 5v14"/>',
