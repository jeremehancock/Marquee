{# Inline stroke icons used by the mobile UI (category tab bar, sort trigger).
   One macro keyed by name so callers stay terse: {{ icons.icon('movies') }}.
   Category names match the tab `value` (all, movies, tv-shows, tv-seasons,
   collections); other names are UI affordances. #}

{% macro icon(name) %}
    {% set paths = {
        'all': '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
        'movies': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 5v14M16 5v14M3 9.5h5M3 14.5h5M16 9.5h5M16 14.5h5"/>',
        'tv-shows': '<rect x="2.5" y="4.5" width="19" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/>',
        'tv-seasons': '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 12.5l9 5 9-5"/>',
        'collections': '<path d="M3 7a2 2 0 0 1 2-2h3.5l2 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>',
        'sort': '<path d="M7 4v15M7 19l-3-3M7 19l3-3M17 20V5M17 5l-3 3M17 5l3 3"/>'
    } %}
    <svg class="icon" viewBox="0 0 24 24" width="22" height="22" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name]|default('')|raw }}</svg>
{% endmacro %}
