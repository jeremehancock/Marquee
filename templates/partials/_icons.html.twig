{# The application's inline stroke icons. One macro keyed by name so callers stay
   terse: {{ icons.icon('movies') }}, or {{ icons.icon('logout', 20) }} where a
   caller needs a different size.

   Every glyph shares one drawing style — a 24-unit viewBox, no fill, a
   currentColor stroke at 1.7, round caps and joins — so a new one can be dropped
   in without looking foreign. Callers:

     category tabs + sort   all, movies, tv-shows, tv-seasons, collections, sort
     header nav + tray      wall, import, orphans, support, logout
     poster actions         change, send, fetch, download, copy, fullscreen,
                            delete

   `fetch` is deliberately an alias of `import` rather than a second drawing of
   the same idea — see the alias table below. #}

{# The import glyph is sideways rather than downward: an arrow falling onto a
   tray is the download idiom, and importing is not downloading. Turned a quarter
   anticlockwise it becomes an arrow entering a boundary, where the boundary is
   Marquee. The geometry is that older path rotated exactly, so the 6px gap
   between the arrowhead and the bar is the one it always had.

   `send` is that same glyph with the arrowhead moved to the far end of an
   identical shaft. Shaft and bar do not move, so direction is the only thing
   separating Send to Plex from Fetch from Plex — the two actions that move one
   image opposite ways and cannot be undone. Note that the downward arrow the
   import glyph gave up is exactly right for `download`, which now uses it. #}
{% macro icon(name, size = 22) %}
    {# Fetch from Plex and Import from Plex are the same operation at different
       scale: one poster against a whole library. They therefore get the same
       mark, and aliasing rather than duplicating is what stops the two drifting
       apart the first time either is retouched. #}
    {% set aliases = { 'fetch': 'import' } %}
    {% set paths = {
        'all': '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
        'movies': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M8 5v14M16 5v14M3 9.5h5M3 14.5h5M16 9.5h5M16 14.5h5"/>',
        'tv-shows': '<rect x="2.5" y="4.5" width="19" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/>',
        'tv-seasons': '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 12.5l9 5 9-5"/>',
        'collections': '<path d="M3 7a2 2 0 0 1 2-2h3.5l2 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>',
        'sort': '<path d="M7 4v15M7 19l-3-3M7 19l3-3M17 20V5M17 5l-3 3M17 5l3 3"/>',
        'wall': '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9.3l4.5 2.7-4.5 2.7z"/>',
        'import': '<path d="M3 12h11"/><path d="M10 16l4-4-4-4"/><path d="M20 5v14"/>',
        'send': '<path d="M3 12h11"/><path d="M7 8l-4 4 4 4"/><path d="M20 5v14"/>',
        'orphans': '<path d="M10.5 13.5a4 4 0 0 0 5.5-.2l2-2a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M13.5 10.5a4 4 0 0 0-5.5.2l-2 2a4 4 0 0 0 5.7 5.7l1-1"/><path d="M4 4l16 16"/>',
        'support': '<path d="M12 20.3l-1.1-1C6.1 15 3 12.2 3 8.8 3 6.1 5.1 4 7.8 4c1.5 0 3 .7 4.2 2 1.2-1.3 2.7-2 4.2-2C18.9 4 21 6.1 21 8.8c0 3.4-3.1 6.2-7.9 10.5l-1.1 1z"/>',
        'logout': '<path d="M14 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4"/><path d="M10 12H3"/><path d="M6 9l-3 3 3 3"/>',
        'change': '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>',
        'download': '<path d="M12 3v11"/><path d="M8 10l4 4 4-4"/><path d="M5 20h14"/>',
        'copy': '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/>',
        'fullscreen': '<path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>',
        'delete': '<path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/><path d="M10 11v6M14 11v6"/>'
    } %}
    {% set name = aliases[name]|default(name) %}
    <svg class="icon" viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none"
         stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name]|default('')|raw }}</svg>
{% endmacro %}
