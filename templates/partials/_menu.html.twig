{# App-wide mobile navigation tray. Reuses the bottom-sheet (.sheet) presentation
   shared with the poster action sheet. Driven by the standalone `menuOpen` scope
   on the topbar (see layout.html.twig), so it is independent of any page's Alpine
   root and works on every page that renders the topbar nav. Shown only on narrow
   screens — the menu button that opens it is hidden on desktop.

   Teleported to <body>, and that is load-bearing rather than tidiness.

   This tray is markup inside <header class="topbar">, because that is where the
   `menuOpen` scope lives. The header is a glass surface, and `backdrop-filter`
   makes an element a containing block for its fixed-position descendants — the
   same rule that catches `transform` and `filter`. So the moment the header went
   translucent, this tray's `position: fixed; inset: 0` stopped resolving against
   the viewport and started resolving against the header's own box: the whole
   full-screen tray rendered squashed into the height of the bar that opened it.

   x-teleport moves the rendered element to <body>, out of the header's containing
   block, while leaving it inside the `menuOpen` scope for reactivity — which is
   the one thing keeping it in the header ever bought. Everything else that
   touches a tray finds it by document-level delegation (the drag gesture, the
   scroll lock), so none of them care where it lives.

   Do not "simplify" this back into a bare div. It renders correctly on a desktop
   viewport either way, because the tray is hidden there. #}
{% import 'partials/_nav_macros.html.twig' as nav %}
{% import 'partials/_transitions.html.twig' as tx %}

<template x-teleport="body">
<div class="sheet" x-show="menuOpen" x-cloak {{ tx.tray() }}
     @keydown.escape.window="menuOpen = false" style="display:none">
    <div class="sheet__backdrop" @click="menuOpen = false"></div>
    <div class="sheet__panel" role="dialog" aria-modal="true" aria-label="Actions" tabindex="-1">
        <div class="sheet__grip"><span class="sheet__handle"></span></div>
        <div class="sheet__head">
            {# "Actions", not "Menu": these are things to do, not places to go, and
               the bare noun matches the sibling trays (Sort, Import from Plex,
               Orphaned posters). #}
            <span class="sheet__title">Actions</span>
        </div>
        {# Choosing a link navigates away; close the tray on any click so it is
           dismissed for same-page and new-tab (Poster Wall) destinations alike. #}
        {# Both groups, in sequence. The desktop header splits them across the bar
           and the ⋯ menu; a phone has a full-width row per entry and no width
           problem to answer, so here they stay one flat list in the order they
           always had. #}
        <div class="sheet__body menu__body" @click="menuOpen = false">
            {{ nav.bar_links(nav_current|default('')) }}
            {{ nav.overflow_links(nav_current|default(''), signed_in()) }}
            {% if signed_in() %}
                {{ nav.connection_status(plex_connection(), nav_current|default('')) }}
            {% endif %}
        </div>
        {# Sits outside .sheet__body, so it closes the tray itself — matching how
           every other new-tab destination in the tray behaves. The handler is on
           the footer rather than each link so the provider logos, which come from
           a partial shared with the page footer (where there is no `menuOpen`
           scope), get the same dismissal by bubbling. #}
        <div class="menu__footer" @click="menuOpen = false">
            {% include 'partials/_attribution.html.twig' %}
            <div><a href="https://getmarquee.now" target="_blank"
                    rel="noopener">{{ app_name }}</a> &middot; v{{ app_version }}<span class="js-update-note"></span></div>
        </div>
    </div>
</div>
</template>
