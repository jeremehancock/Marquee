{# App-wide mobile navigation tray. Reuses the bottom-sheet (.sheet) presentation
   shared with the poster action sheet. Driven by the standalone `menuOpen` scope
   on the topbar (see layout.html.twig), so it is independent of any page's Alpine
   root and works on every page that renders the topbar nav. Shown only on narrow
   screens — the menu button that opens it is hidden on desktop. #}
{% import 'partials/_nav_macros.html.twig' as nav %}

<div class="sheet" x-show="menuOpen" x-cloak
     @keydown.escape.window="menuOpen = false" style="display:none">
    <div class="sheet__backdrop" @click="menuOpen = false"></div>
    <div class="sheet__panel" role="dialog" aria-modal="true" aria-label="Menu">
        <div class="sheet__grip"><span class="sheet__handle"></span></div>
        <div class="sheet__head">
            <span class="sheet__title">Menu</span>
        </div>
        {# Choosing a link navigates away; close the tray on any click so it is
           dismissed for same-page and new-tab (Poster Wall) destinations alike. #}
        <div class="sheet__body menu__body" @click="menuOpen = false">
            {{ nav.secondary_links() }}
            {% if not auth_bypass %}
                {{ nav.logout_link(true) }}
            {% endif %}
        </div>
        {# Sits outside .sheet__body, so it closes the tray itself — matching how
           every other new-tab destination in the tray behaves. #}
        <div class="menu__footer"><a href="https://marquee.dumbprojects.com" target="_blank"
                rel="noopener" @click="menuOpen = false">{{ app_name }}</a> &middot; v{{ app_version }}<span class="js-update-note"></span></div>
    </div>
</div>
