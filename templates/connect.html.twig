{% extends 'layout.html.twig' %}

{# Suppresses the header's own link, which would point at this page. #}
{% set nav_current = 'connect' %}

{% block title %}Plex Connection · {{ site_title }}{% endblock %}

{% block content %}
    {# Only once connected. While the gate is up the gallery is unreachable, so
       the link would bounce straight back here. #}
    {% if connection.isConnected %}
        <p><a class="search__clear" href="{{ back_url }}">&larr; Back to gallery</a></p>
    {% endif %}
    <h1>Plex Connection</h1>

    {% if flash %}
        <p class="alert alert--{{ flash.type }}" role="alert">{{ flash.message }}</p>
    {% endif %}

    {#
        Two states — connected or not — because there is one way to connect.
        What still has to be told apart is why it is not connected: a missing
        credential is fixed by signing in, a missing server address is not, and
        offering the wrong remedy leaves the user stuck behind the gate.
    #}
    <div class="panel plex-connection" x-data="plexConnection()">
        {% if connection.isConnected %}
            <p class="plex-connection__server">
                <strong>Connected to {{ connection.serverName ?? 'Plex' }}</strong>
            </p>
            <p class="stats">
                Your poster library and imports use this connection. It is
                separate from your Marquee login, which is what controls who can
                open the app.
            </p>
            <form method="post" action="/plex/connection/sign-out">
                <button type="submit" class="btn btn--danger">Disconnect from Plex</button>
            </form>
        {% elseif connection.needsServerUrl %}
            <p><strong>Plex is not connected.</strong></p>
            <p class="stats">
                Marquee needs your Plex server's address. Set
                <code>PLEX_SERVER_URL</code> in your compose file and run
                <code>docker compose up -d</code> — signing in cannot supply an
                address.
            </p>
        {% else %}
            <p><strong>Plex is not connected.</strong></p>
            <p class="stats">
                Connect Marquee to Plex so it can import your posters and send
                your changes back. A Plex window opens for you to sign in and
                approve it.
            </p>
            <button type="button" class="btn btn--accent"
                    @click="signIn()" x-bind:disabled="busy"
                    x-text="busy ? 'Waiting for Plex…' : 'Connect to Plex'">Connect to Plex</button>
        {% endif %}

        {# Shown only when the popup was blocked, so the flow still completes. #}
        <p class="plex-connection__fallback stats" x-show="fallbackUrl" x-cloak>
            Your browser blocked the Plex window.
            <a x-bind:href="fallbackUrl" target="_blank" rel="noopener">Open Plex sign-in</a>
        </p>

        <p class="alert plex-connection__message" role="alert"
           x-show="message" x-cloak x-text="message"></p>
    </div>

    {# Restricting sign-in to the server's owner reads like a limit on people.
       It is not — it decides which credential Marquee holds. Every Plex action
       runs on that credential and no route asks who the visitor is, so with the
       login off, whoever reaches Marquee acts as the owner. Saying only that a
       stranger "could change the connection" invites exactly the wrong
       inference, so the risk is named as use of the connection, and the
       owner-only rule is stated and then closed off. #}
    {% if auth_bypass %}
        <div class="alert plex-connection__obsolete" role="status">
            <p><strong>Login is disabled (<code>AUTH_BYPASS</code>).</strong>
               Anyone who can reach Marquee acts with your stored Plex
               connection — they can change and delete posters, send artwork to
               your Plex library, and disconnect this install.</p>
            <p>Only your own Plex account can connect Marquee, but that does not
               limit what someone can do once it is connected. Leave the login
               disabled only on a network you fully trust.</p>
        </div>
    {% endif %}

    {# An install upgraded from a version that read PLEX_TOKEN arrives here
       disconnected and with no idea why. This is the sentence that explains it.

       The instruction has to name recreating the container, not just editing the
       file: the environment is read once when the container starts, so deleting
       the variable and restarting leaves it exactly as it was — which is the
       first thing anyone tries. #}
    {% if connection.hasObsoleteEnvToken %}
        <div class="alert alert--warning plex-connection__obsolete" role="status">
            <p><strong><code>PLEX_TOKEN</code> is no longer used.</strong>
               Marquee connects by signing in to Plex from this screen, so the
               token in your environment is ignored.</p>
            {% if connection.isConnected %}
                <p>You are connected, so it is safe to remove. Delete
                   <code>PLEX_TOKEN</code> from your compose file and run
                   <code>docker compose up -d</code>.</p>
            {% else %}
                <p>Connect above, then delete <code>PLEX_TOKEN</code> from your
                   compose file and run <code>docker compose up -d</code>.</p>
            {% endif %}
            <p><strong>Recreating the container is what clears this notice</strong>
               — <code>docker compose restart</code> is not enough, because the
               environment is only read when the container starts.</p>
        </div>
    {% endif %}
{% endblock %}
