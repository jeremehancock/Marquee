{% extends 'layout.html.twig' %}

{# Suppresses the header's own link, which would point at this page. #}
{% set nav_current = 'connect' %}

{% block title %}{{ signed_in ? 'Plex Connection' : 'Sign in' }} · {{ site_title }}{% endblock %}

{# No navigation for a visitor who has not signed in: there is nothing behind it
   they may reach, and a header full of dead links is the first thing they would
   see of Marquee. #}
{% block nav %}{% if signed_in %}{{ parent() }}{% endif %}{% endblock %}

{% block content %}
    {# Only once connected, and only for someone who may use the gallery. While
       the gate is up the link would bounce straight back here. #}
    {% if signed_in and connection.isConnected %}
        <p><a class="search__clear" href="{{ back_url }}">&larr; Back to gallery</a></p>
    {% endif %}

    <h1>{{ signed_in ? 'Plex Connection' : 'Sign in to Marquee' }}</h1>

    {% if flash %}
        <p class="alert alert--{{ flash.type }}" role="alert">{{ flash.message }}</p>
    {% endif %}

    {#
        One way in, so one action. What still has to be told apart is why Marquee
        cannot be used: a missing credential is fixed by signing in, a missing
        server address is not, and offering the wrong remedy leaves the user
        stuck in front of a button that cannot help them.
    #}
    <div class="panel plex-connection" x-data="plexConnection()">
        {% if connection.needsServerUrl %}
            <p><strong>Marquee needs your Plex server's address.</strong></p>
            <p class="stats">
                Set <code>PLEX_SERVER_URL</code> in your compose file and run
                <code>docker compose up -d</code>. Signing in cannot supply an
                address, so this has to be fixed before Marquee can check who
                owns your server.
            </p>
        {% elseif signed_in and connection.isConnected %}
            <p class="plex-connection__server">
                <strong>Connected to {{ connection.serverName ?? 'Plex' }}</strong>
            </p>
            <p class="stats">
                Your poster library, imports, and the Poster Wall all use this
                connection.
            </p>

            {# The two exits, named and contrasted rather than one described and
               the other waved at. This said "Logging out does neither", which
               asked the reader to hold two consequences in mind and map a
               pronoun back onto them; naming each subject is what makes the
               difference legible at a glance.

               Naming the action is not enough either. Disconnecting looks like
               the tidy way to leave, and nothing about the word says it stops
               imports running on a schedule nobody is watching, or takes the
               live half of a wall someone may be looking at across the room. #}
            <p class="stats">
                <strong>Disconnecting</strong> forgets this connection. Marquee
                stops working until someone signs in to Plex again, scheduled
                auto-imports stop, and the Poster Wall keeps the posters you
                have already imported but stops showing what is playing.
            </p>
            <p class="stats">
                <strong>Logging out</strong> only ends your session in this
                browser. The connection stays, so scheduled auto-imports and the
                Poster Wall carry on.
            </p>
            <form method="post" action="/plex/connection/sign-out">
                {{ csrf_field() }}
                <button type="submit" class="btn btn--danger">Disconnect from Plex</button>
            </form>
        {% else %}
            {% if signed_in %}
                <p><strong>Plex is not connected.</strong></p>
                <p class="stats">
                    Sign in with the Plex account that owns this server, so
                    Marquee can import your posters and send your changes back.
                </p>
            {% else %}
                <p class="stats">
                    Sign in with the Plex account that owns this server.
                </p>
            {% endif %}
            <button type="button" class="btn btn--accent"
                    @click="signIn()" x-bind:disabled="busy"
                    x-text="busy ? 'Waiting for Plex…' : 'Sign in with Plex'">Sign in with Plex</button>
        {% endif %}

        {# Shown only when the popup was blocked, so the flow still completes. #}
        <p class="plex-connection__fallback stats" x-show="fallbackUrl" x-cloak>
            Your browser blocked the Plex window.
            <a x-bind:href="fallbackUrl" target="_blank" rel="noopener">Open Plex sign-in</a>
        </p>

        <p class="alert plex-connection__message" role="alert"
           x-show="message" x-cloak x-text="message"></p>
    </div>

    {# An install upgraded from a version that read PLEX_TOKEN arrives here
       disconnected and with no idea why. This is the sentence that explains it.

       The instruction has to name recreating the container, not just editing the
       file: the environment is read once when the container starts, so deleting
       the variable and restarting leaves it exactly as it was — which is the
       first thing anyone tries. #}
    {% if connection.hasObsoleteEnvToken %}
        <div class="alert alert--warning plex-connection__obsolete" role="status">
            <p><strong><code>PLEX_TOKEN</code> is no longer used.</strong>
               Marquee gets its credential from signing in to Plex on this
               screen, so the token in your environment is ignored.</p>
            {% if connection.isConnected %}
                <p>You are connected, so it is safe to remove. Delete
                   <code>PLEX_TOKEN</code> from your compose file and run
                   <code>docker compose up -d</code>.</p>
            {% else %}
                <p>Sign in above, then delete <code>PLEX_TOKEN</code> from your
                   compose file and run <code>docker compose up -d</code>.</p>
            {% endif %}
            <p><strong>Recreating the container is what clears this notice</strong>
               — <code>docker compose restart</code> is not enough, because the
               environment is only read when the container starts.</p>
        </div>
    {% endif %}

    {# Same job as the notice above, for the credentials this screen replaced.
       An install upgraded from a version with its own login arrives at a screen
       that no longer asks for the password in its compose file. #}
    {% if obsolete_bypass %}
        <div class="alert alert--warning plex-connection__obsolete" role="status">
            <p><strong><code>AUTH_BYPASS</code> no longer disables the login.</strong>
               Marquee is now opened by signing in to Plex, and only the account
               that owns your Plex server can do it. There is no way to turn the
               login off.</p>
            <p>Delete <code>AUTH_BYPASS</code> from your compose file and run
               <code>docker compose up -d</code>. The Poster Wall is unaffected —
               it still runs on an unattended display without anyone signing in.</p>
        </div>
    {% endif %}

    {% if obsolete_credentials %}
        <div class="alert alert--warning plex-connection__obsolete" role="status">
            <p><strong><code>AUTH_USERNAME</code> and <code>AUTH_PASSWORD</code>
               are no longer used.</strong> Marquee is opened by signing in to
               Plex as the account that owns your server, so the credentials in
               your environment are ignored.</p>
            <p>Delete them from your compose file and run
               <code>docker compose up -d</code>.</p>
        </div>
    {% endif %}
{% endblock %}
