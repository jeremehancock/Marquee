#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# Prepare the /config volume and schedule auto-import.

# /config/sessions is where PHP sessions live, so that recreating the container
# does not sign everybody out. The app creates it too — it cannot be left to
# this script alone, which knows nothing about a SESSION_DIR pointing elsewhere.
mkdir -p \
    /config/data \
    /config/sessions \
    /config/posters/movies \
    /config/posters/tv-shows \
    /config/posters/tv-seasons \
    /config/posters/collections

lsiown -R abc:abc /config

# Sessions are readable only by the user that runs the app. PHP writes the
# session files 0600; the directory holding them should not be looser.
chmod 700 /config/sessions

# Cron jobs DO get the container environment: the cron service runs under
# with-contenv, so crond inherits it and passes it to everything it spawns.
# There used to be a docker-env.sh written here to "fix" that; it fixed nothing,
# and its own grep silently dropped every PLEX_* and AUTO_IMPORT_* variable
# because `^(PLEX_|...)=` matches a variable named literally "PLEX_". Removed
# rather than corrected — the file it wrote was never needed.
rm -f /app/docker-env.sh
chmod +x /app/auto-import.sh

# A fixed hourly tick, written unconditionally. The application decides whether a
# tick is due, from settings a user can change in the browser.
#
# This used to map AUTO_IMPORT_SCHEDULE to a cron expression here, and write the
# file only when AUTO_IMPORT_ENABLED was true. That made the schedule
# unchangeable without recreating the container, and — because svc-cron started
# crond only when this file was non-empty — left an install that booted with
# auto-import off with no cron process at all, so nothing could ever turn it on.
#
# Hourly is enough: every interval offered (1h/3h/6h/12h/24h) is a whole number
# of hours dividing the day, so the application can hit each of its slots exactly.
echo "0 * * * * /app/auto-import.sh" > /etc/crontabs/abc
