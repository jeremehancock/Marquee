#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# The first startup step: who the application runs as, and which timezone it
# keeps. Everything else waits for this, so nothing serves a request or writes a
# file before both are settled.

# Run as PUID/PGID, so the files Marquee writes in /config belong to the host
# user who owns the volume. 911 is the documented default.
PUID=${PUID:-911}
PGID=${PGID:-911}
groupmod -o -g "$PGID" abc
usermod -o -u "$PUID" abc

# nginx's workers run as abc and buffer large responses (the gallery, poster
# images) to disk here whenever the client reads slower than PHP writes. Created
# at build time for uid 911, so after the remap above the workers could not open
# it and cut those responses off mid-stream, which a browser behind an HTTP/2
# proxy reports as ERR_HTTP2_PROTOCOL_ERROR and a blank page.
chown -R abc:abc /var/lib/nginx

# TZ, for both clocks that matter. crond reads the system zone (and TZ itself),
# but PHP reads neither, only date.timezone. AutoImportSchedule anchors its
# slots at local midnight and relies on the two agreeing.
TZ=${TZ:-Etc/UTC}
if [[ ! -f "/usr/share/zoneinfo/${TZ}" ]]; then
    echo "TZ '${TZ}' is not a known timezone; using Etc/UTC"
    TZ=Etc/UTC
fi
ln -sf "/usr/share/zoneinfo/${TZ}" /etc/localtime
echo "${TZ}" > /etc/timezone
printf 'date.timezone = "%s"\n' "${TZ}" > "${PHP_INI_DIR:-/usr/local/etc/php}/conf.d/zz-timezone.ini"

cat <<BANNER
───────────────────────────────────────
  __  __
 |  \/  | __ _ _ __ __ _ _   _  ___  ___
 | |\/| |/ _\` | '__/ _\` | | | |/ _ \/ _ \\
 | |  | | (_| | | | (_| | |_| |  __/  __/
 |_|  |_|\__,_|_|  \__, |\__,_|\___|\___|
                      |_|
  Media poster manager
───────────────────────────────────────
User UID:    $(id -u abc)
User GID:    $(id -g abc)
Timezone:    ${TZ}
PHP:         $(php -r 'echo PHP_VERSION;')
───────────────────────────────────────
BANNER
